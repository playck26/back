# Copiar para .env e preencher com valores reais (nunca commitar .env).

# Banco LOCAL. **Nunca a URL de produção aqui** — ADR-016.
#
# O Prisma carrega o `.env` sozinho, então o que estiver nesta variável é o
# alvo PADRÃO de todo comando: `test:banco`, `migrate reset`, qualquer script.
# Em 2026-08-24 essa variável apontava para produção e uma suíte de teste
# apagou os dados. A URL de produção vive em `.env.production.local`, que
# nada carrega sozinho.
#
# O Postgres local do projeto sobe assim:
#   docker run -d --name playck-harness -e POSTGRES_PASSWORD=harness #     -e POSTGRES_DB=playck -p 55432:5432 postgres:16
DATABASE_URL="postgresql://postgres:harness@localhost:55432/playck?schema=public"

# Segredos de JWT (gerar valores aleatórios fortes antes do primeiro deploy;
# qualquer valor serve para desenvolvimento local).
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao"
JWT_REFRESH_EXPIRES_IN="7d"

# Porta HTTP local.
PORT=3000

# Origem(ns) permitida(s) para CORS, separadas por vírgula (frontends locais).
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# SPEC-017 / ADR-015 — DigitalOcean Spaces (bucket próprio `playck-media`).
# As seis são obrigatórias: o app NÃO sobe sem elas. O endpoint é o
# REGIONAL, sem o nome do bucket na frente — o painel da DigitalOcean
# mostra a forma com bucket, e copiar de lá quebra em runtime.
SPACES_REGION="nyc3"
SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
SPACES_BUCKET="playck-media"
SPACES_CDN_URL="https://playck-media.nyc3.cdn.digitaloceanspaces.com"
SPACES_KEY="chave-limited-access-do-bucket"
SPACES_SECRET="segredo-da-chave"
