// Schema Prisma - back (PlayCK)
// Fonte de verdade do modelo: DATA_MODEL.md (raiz do projeto).
// Escopo inicial (SPEC-001:TASK-002): empresas, usuarios, refresh_tokens.
// Estendido por SPEC-003:TASK-000a (niveis, professores, alunos). Demais
// tabelas (quadras, turmas, ...) entram por spec dona, cada uma
// estendendo este arquivo (nunca um schema paralelo).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist(map: "btree_gist")]
}

enum EmpresaStatus {
  ativa
  inativa

  @@map("empresa_status")
}

enum UsuarioRole {
  super_admin
  company_admin
  aluno

  @@map("usuario_role")
}

enum UsuarioStatus {
  ativo
  inativo

  @@map("usuario_status")
}

model Empresa {
  id        String        @id @default(uuid()) @db.Uuid
  nome      String        @unique
  logoUrl   String?       @map("logo_url")
  esportes  String[]
  status    EmpresaStatus @default(ativa)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  usuarios    Usuario[]
  niveis      Nivel[]
  professores Professor[]
  alunos      Aluno[]

  @@map("empresas")
}

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  nome         String
  telefone     String?
  role         UsuarioRole
  companyId    String?       @map("company_id") @db.Uuid
  status       UsuarioStatus @default(ativo)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  empresa       Empresa?       @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]
  aluno         Aluno?

  @@index([companyId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Nivel {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nome      String
  ordem     Int
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [companyId], references: [id])
  alunos  Aluno[]

  @@unique([companyId, nome])
  @@index([companyId])
  @@map("niveis")
}

model Professor {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  nome      String
  telefone  String?
  email     String?
  status    UsuarioStatus @default(ativo)
  createdAt DateTime      @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("professores")
}

model Aluno {
  id        String        @id @default(uuid()) @db.Uuid
  usuarioId String        @unique @map("usuario_id") @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  nivelId   String?       @map("nivel_id") @db.Uuid
  status    UsuarioStatus @default(ativo)
  createdAt DateTime      @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [companyId], references: [id])
  nivel   Nivel?  @relation(fields: [nivelId], references: [id])

  @@index([companyId])
  @@map("alunos")
}
