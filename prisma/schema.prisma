// Schema Prisma - back (PlayCK)
// Fonte de verdade do modelo: DATA_MODEL.md (raiz do projeto).
// Escopo inicial (SPEC-001:TASK-002): empresas, usuarios, refresh_tokens.
// Estendido por SPEC-003:TASK-000a (niveis, professores, alunos), por
// SPEC-004:TASK-001 (quadras, ocupacoes_quadra), por SPEC-003:TASK-000b
// (turmas, turma_alunos) e por SPEC-006:TASK-000 (config_pagamento_empresa).
// Demais tabelas entram por spec dona, cada uma estendendo este arquivo
// (nunca um schema paralelo).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist(map: "btree_gist")]
}

enum EmpresaStatus {
  ativa
  inativa

  @@map("empresa_status")
}

enum UsuarioRole {
  super_admin
  company_admin
  aluno

  @@map("usuario_role")
}

enum UsuarioStatus {
  ativo
  inativo

  @@map("usuario_status")
}

model Empresa {
  id        String        @id @default(uuid()) @db.Uuid
  nome      String        @unique
  logoUrl   String?       @map("logo_url")
  esportes  String[]
  status    EmpresaStatus @default(ativa)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  usuarios         Usuario[]
  niveis           Nivel[]
  professores      Professor[]
  alunos           Aluno[]
  quadras          Quadra[]
  ocupacoes        OcupacaoQuadra[]
  turmas           Turma[]
  configPagamento  ConfigPagamentoEmpresa?

  @@map("empresas")
}

model Usuario {
  id        String        @id @default(uuid()) @db.Uuid
  email     String        @unique
  senhaHash String        @map("senha_hash")
  nome      String
  telefone  String?
  role      UsuarioRole
  companyId String?       @map("company_id") @db.Uuid
  status    UsuarioStatus @default(ativo)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  empresa       Empresa?       @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]
  aluno         Aluno?

  @@index([companyId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Nivel {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nome      String
  ordem     Int
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [companyId], references: [id])
  alunos  Aluno[]
  turmas  Turma[]

  @@unique([companyId, nome])
  @@index([companyId])
  @@map("niveis")
}

model Professor {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  nome      String
  telefone  String?
  email     String?
  status    UsuarioStatus @default(ativo)
  createdAt DateTime      @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [companyId], references: [id])
  turmas  Turma[]

  @@index([companyId])
  @@map("professores")
}

model Aluno {
  id        String        @id @default(uuid()) @db.Uuid
  usuarioId String        @unique @map("usuario_id") @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  nivelId   String?       @map("nivel_id") @db.Uuid
  status    UsuarioStatus @default(ativo)
  createdAt DateTime      @default(now()) @map("created_at")

  usuario     Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa     Empresa          @relation(fields: [companyId], references: [id])
  nivel       Nivel?           @relation(fields: [nivelId], references: [id])
  ocupacoes   OcupacaoQuadra[]
  turmaAlunos TurmaAluno[]

  @@index([companyId])
  @@map("alunos")
}

enum QuadraStatus {
  ativa
  inativa

  @@map("quadra_status")
}

model Quadra {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  nome      String
  esporte   String
  precoHora Decimal      @map("preco_hora") @db.Decimal(10, 2)
  status    QuadraStatus @default(ativa)
  createdAt DateTime     @default(now()) @map("created_at")

  empresa   Empresa          @relation(fields: [companyId], references: [id])
  ocupacoes OcupacaoQuadra[]
  turmas    Turma[]

  @@index([companyId])
  @@map("quadras")
}

enum OrigemTipo {
  TURMA
  AVULSO

  @@map("origem_tipo")
}

enum StatusPagamento {
  pendente_pagamento
  pago
  cancelado

  @@map("status_pagamento")
}

// Tabela mais crítica do domínio (ADR-009, INV-001) — ver a constraint
// `EXCLUDE USING gist` adicionada manualmente na migration (não
// expressável no schema.prisma) logo abaixo do CREATE TABLE gerado.
model OcupacaoQuadra {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  quadraId        String          @map("quadra_id") @db.Uuid
  data            DateTime        @db.Date
  horaInicio      DateTime        @map("hora_inicio") @db.Time
  horaFim         DateTime        @map("hora_fim") @db.Time
  origemTipo      OrigemTipo      @map("origem_tipo")
  origemTurmaId   String?         @map("origem_turma_id") @db.Uuid
  alunoId         String?         @map("aluno_id") @db.Uuid
  statusPagamento StatusPagamento @default(pendente_pagamento) @map("status_pagamento")
  clientRequestId String?         @map("client_request_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  empresa     Empresa @relation(fields: [companyId], references: [id])
  quadra      Quadra  @relation(fields: [quadraId], references: [id])
  aluno       Aluno?  @relation(fields: [alunoId], references: [id])
  origemTurma Turma?  @relation(fields: [origemTurmaId], references: [id])

  @@index([companyId, quadraId, data])
  @@map("ocupacoes_quadra")
}

enum TurmaStatus {
  ativa
  inativa

  @@map("turma_status")
}

// Horário recorrente semanal fixo por turma no MVP (DATA_MODEL.md). Nunca
// escreve em `ocupacoes_quadra` diretamente — só através do método público
// `CourtsService.registerClassOccupancy(...)` (MOD-005 continua dono
// exclusivo da linha do tempo da quadra, TARGET_ARCHITECTURE.md seção 6).
model Turma {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  nome        String
  nivelId     String?     @map("nivel_id") @db.Uuid
  professorId String?     @map("professor_id") @db.Uuid
  quadraId    String      @map("quadra_id") @db.Uuid
  diaSemana   Int         @map("dia_semana")
  horaInicio  DateTime    @map("hora_inicio") @db.Time
  horaFim     DateTime    @map("hora_fim") @db.Time
  capacidade  Int
  status      TurmaStatus @default(ativa)
  createdAt   DateTime    @default(now()) @map("created_at")

  empresa   Empresa          @relation(fields: [companyId], references: [id])
  nivel     Nivel?           @relation(fields: [nivelId], references: [id])
  professor Professor?       @relation(fields: [professorId], references: [id])
  quadra    Quadra           @relation(fields: [quadraId], references: [id])
  alunos    TurmaAluno[]
  ocupacoes OcupacaoQuadra[]

  @@index([companyId])
  @@index([quadraId])
  @@map("turmas")
}

// Alocação many-to-many aluno<->turma (DATA_MODEL.md). Contagem por
// turma_id nunca excede turmas.capacidade (INV-003) — checado em
// transação com `SELECT ... FOR UPDATE` na linha da turma, não só pela
// UNIQUE(turma_id, aluno_id) abaixo (que só evita duplicata do mesmo
// aluno, não estoura de capacidade).
model TurmaAluno {
  id        String   @id @default(uuid()) @db.Uuid
  turmaId   String   @map("turma_id") @db.Uuid
  alunoId   String   @map("aluno_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([turmaId, alunoId])
  @@index([turmaId])
  @@index([alunoId])
  @@map("turma_alunos")
}

// MOD-006 (SPEC-006): configuração de como a empresa recebe pagamento
// (link externo e/ou WhatsApp) — regra de "pelo menos um preenchido" é
// validada na aplicação, não em CHECK de banco (DATA_MODEL.md, regra de
// produto pode mudar mais fácil que constraint).
model ConfigPagamentoEmpresa {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @unique @map("company_id") @db.Uuid
  linkPagamentoUrl  String?  @map("link_pagamento_url")
  whatsappNumero    String?  @map("whatsapp_numero")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [companyId], references: [id])

  @@map("config_pagamento_empresa")
}
