// Schema Prisma - back (PlayCK)
// Fonte de verdade do modelo: DATA_MODEL.md (raiz do projeto).
// Escopo inicial (SPEC-001:TASK-002): empresas, usuarios, refresh_tokens.
// Estendido por SPEC-003:TASK-000a (niveis, professores, alunos), por
// SPEC-004:TASK-001 (quadras, ocupacoes_quadra), por SPEC-003:TASK-000b
// (turmas, turma_alunos), por SPEC-006:TASK-000 (config_pagamento_empresa)
// por SPEC-009:TASK-000 (onboarding de conta do aluno) e por
// SPEC-010:TASK-000 (horarios_funcionamento) e por SPEC-011:TASK-000
// (valor da reserva e pedidos_reserva).
// Demais tabelas entram por spec dona, cada uma estendendo este arquivo
// (nunca um schema paralelo).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist(map: "btree_gist")]
}

enum EmpresaStatus {
  ativa
  inativa

  @@map("empresa_status")
}

enum UsuarioRole {
  super_admin
  company_admin
  aluno
  // SPEC-013: acrescentado **no fim** de proposito. `ALTER TYPE ADD VALUE`
  // sem `BEFORE`/`AFTER` anexa ao final; declarar aqui em outra posicao
  // criaria drift permanente entre schema e banco.
  professor

  @@map("usuario_role")
}

enum UsuarioStatus {
  ativo
  inativo

  @@map("usuario_status")
}

// SPEC-009: separa "a empresa reconhece esta pessoa como aluno" de
// "a pessoa preencheu um formulario". Quem se auto-cadastra (C1) nasce
// `pendente`; convite (C2) e cadastro pelo admin (C3) nascem `aprovado`,
// porque nos dois a iniciativa foi da empresa. O default do banco e
// `pendente` de proposito (fail-closed): se um caminho novo esquecer de
// definir o vinculo, a conta nasce restrita, nunca liberada.
enum VinculoAluno {
  pendente
  aprovado
  recusado

  @@map("vinculo_aluno")
}

model Empresa {
  id                  String        @id @default(uuid()) @db.Uuid
  nome                String        @unique
  // SPEC-009: identifica a empresa no link publico de auto-cadastro
  // (`/cadastro/<slug>`), para nao expor `company_id` cru na URL.
  slug                String        @unique
  /// SPEC-018/AC-012: continua valida e NAO migra. Empresa que ja tem URL
  /// externa segue exibindo ela ate alguem subir um logo de verdade.
  logoUrl             String?       @map("logo_url")
  /// SPEC-018/TASK-001 — chave do logo no storage (SPEC-017). Publica.
  /// Precedencia na leitura: `logoKey` quando existir, senao `logoUrl`.
  logoKey             String?       @map("logo_key")
  /// SPEC-020/TASK-004 — `esportes String[]` saiu daqui. A INV-057 pede UMA
  /// lista de esportes por empresa, e ela e `esportesQuadra` (o catalogo).
  /// Duas listas que nao se falam era o estado que esta spec veio desfazer:
  /// o clube nascia com a coluna preenchida e o catalogo vazio.
  status              EmpresaStatus @default(ativa)
  // SPEC-009/REQ-006: a empresa decide se aceita auto-cadastro publico.
  // Ligado por padrao (ADR-013); seguro porque quem se auto-cadastra
  // nasce `pendente` e nao ocupa nada ate um admin aprovar (INV-010).
  permiteAutoCadastro Boolean       @default(true) @map("permite_auto_cadastro")

  /// SPEC-023 — quantas turmas um aluno pode entrar POR CONTA PROPRIA.
  /// `NULL` = sem limite, e e o padrao: empresa existente nao muda de
  /// comportamento por causa de uma coluna nova. O CHECK do banco garante
  /// `>= 1` — zero seria "ninguem entra", que e desligar, nao limitar.
  ///
  /// **Vale para ENTRAR, nunca para expulsar** (INV-023a): baixar o limite
  /// nao tira ninguem de turma em que ja esta.
  limiteTurmasPorAluno Int? @map("limite_turmas_por_aluno")

  /// SPEC-024 — a versao do contrato do clube que esta valendo.
  /// `NULL` = o clube nao publicou contrato, e nesse caso so o termo da
  /// plataforma e exigido (REQ-005). E o estado de toda empresa existente
  /// no dia da migration.
  contratoVersaoVigente Int?     @map("contrato_versao_vigente")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  usuarios         Usuario[]
  convites         ConviteAluno[]
  horarios         HorarioFuncionamento[]
  pedidosReserva   PedidoReserva[]
  niveis           Nivel[]
  esportesQuadra   EsporteDeQuadra[]
  categoriasQuadra CategoriaDeQuadra[]
  professores      Professor[]
  alunos           Aluno[]
  quadras          Quadra[]
  ocupacoes        OcupacaoQuadra[]
  turmas           Turma[]
  configPagamento  ConfigPagamentoEmpresa?
  configOperacao   ConfigOperacaoEmpresa?
  contratos        ContratoDaEmpresa[]
  avaliacoesDeAula AvaliacaoDeAula[]

  presencas                 Presenca[]
  chamadas                  Chamada[]
  acaoAdministrativas       AcaoAdministrativa[]
  faltasAvisadas            FaltaAvisada[]
  reposicoesDeAula          ReposicaoDeAula[]
  disponibilidadeProfessors DisponibilidadeProfessor[]
  planos                    Plano[]
  matriculas                Matricula[]
  tiposDeAdicional          TipoDeAdicional[]

  @@map("empresas")
}

model Usuario {
  id                      String        @id @default(uuid()) @db.Uuid
  email                   String        @unique
  senhaHash               String        @map("senha_hash")
  nome                    String
  telefone                String?
  role                    UsuarioRole
  companyId               String?       @map("company_id") @db.Uuid
  status                  UsuarioStatus @default(ativo)
  // SPEC-009/REQ-003: conta criada pelo admin nasce com senha temporaria.
  // Enquanto `senhaTemporaria` for true, INV-008 bloqueia tudo no servidor
  // fora trocar senha, /auth/me e logout.
  senhaTemporaria         Boolean       @default(false) @map("senha_temporaria")
  senhaTemporariaExpiraEm DateTime?     @map("senha_temporaria_expira_em")
  /// SPEC-018/TASK-001 — foto de perfil de quem TEM conta (INV-034). Privada.
  /// CHECK escrito a mao exige que a chave more sob a empresa do usuario, o
  /// que significa que `super_admin` (sem `companyId`) nao tem foto — ver o
  /// comentario da migration, e a pergunta aberta da TASK-003.
  fotoKey                 String?       @map("foto_key")
  /// SPEC-024 — as duas colunas que o PORTAO le, a cada requisicao
  /// autenticada. O historico completo mora em `aceites`; estas respondem
  /// "esta em dia?" sem um ORDER BY por requisicao. As duas verdades nao
  /// divergem porque sao escritas na mesma transacao.
  termoVersaoAceita       Int?          @map("termo_versao_aceita")
  contratoVersaoAceita    Int?          @map("contrato_versao_aceita")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  empresa                      Empresa?             @relation(fields: [companyId], references: [id])
  refreshTokens                RefreshToken[]
  aluno                        Aluno?
  professor                    Professor?
  convitesCriados              ConviteAluno[]       @relation("ConviteCriadoPor")
  presencasRegistradas         Presenca[]           @relation("PresencaRegistradaPor")
  chamadasRegistradas          Chamada[]            @relation("ChamadaRegistradaPor")
  imagensDeQuadraConfirmadas   Quadra[]             @relation("QuadraImagemConfirmadaPor")
  aceites                      Aceite[]
  acoesRegistradas             AcaoAdministrativa[] @relation("AcaoRegistradaPor")
  movimentosDeCreditoAutorados MovimentoDeCredito[] @relation("MovimentoRegistradoPor")
  /// SPEC-037 — quem matriculou. Nomeada porque `Matricula` tem DUAS pernas
  /// para `usuarios`: esta (o autor) e a do aceite, que passa por `Aceite`.
  matriculasCriadas            Matricula[]          @relation("MatriculaCriadaPor")
  /// SPEC-062 — os aparelhos desta pessoa e os avisos destinados a ela.
  assinaturasPush              AssinaturaPush[]
  notificacoes                 Notificacao[]

  /// DEF-024 fase 1 — alvo da FK composta de `alunos`. `company_id` aqui e
  /// NULAVEL (super_admin nao tem empresa), e um UNIQUE sobre coluna nulavel
  /// e legitimo; como `id` e PK, ele nunca falha por duplicata.
  @@unique([companyId, id], map: "usuarios_company_id_id_key")
  @@index([companyId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Nivel {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nome      String
  ordem     Int
  createdAt DateTime @default(now()) @map("created_at")

  empresa  Empresa        @relation(fields: [companyId], references: [id])
  alunos   Aluno[]
  turmas   Turma[]
  convites ConviteAluno[]

  @@unique([companyId, nome])
  /// SPEC-075/D9 — o alvo das FKs compostas de `alunos`, `turmas` e
  /// `convites_aluno`. Redundante como chave (`id` ja e PK); existe para o
  /// banco recusar o nivel de outra empresa.
  @@unique([companyId, id])
  @@index([companyId])
  @@map("niveis")
}

model Professor {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  nome      String
  telefone  String?
  email     String?
  status    UsuarioStatus @default(ativo)
  /// SPEC-047/D1 — o preco da aula particular DESTE professor, em reais.
  /// **Nulo significa "usa o padrao do clube", nunca "de graca"** — o molde
  /// que os prazos e o teto de reposicao ja usam. Sem preco proprio nem
  /// padrao, o professor nao e oferecido ao aluno (D2).
  precoAula Decimal?      @map("preco_aula") @db.Decimal(10, 2)
  // SPEC-013/INV-014: nulo e o estado normal — professor cadastrado sem
  // acesso continua valido, e a maioria vai ficar assim. `SetNull` no
  // delete: apagar a conta nao apaga a ficha do professor, so o vinculo.
  usuarioId String?       @unique @map("usuario_id") @db.Uuid
  /// SPEC-018/TASK-001 — foto do professor SEM conta, subida pelo gestor na
  /// ficha. Privada. Existe porque `usuarioId` e nulavel (decisao 2): sem
  /// esta coluna, professor sem login nao teria onde guardar foto. Quem tem
  /// conta manda na propria imagem — `coalesce(usuarios.foto_key,
  /// professores.foto_key)`, INV-034.
  fotoKey   String?       @map("foto_key")
  createdAt DateTime      @default(now()) @map("created_at")

  empresa Empresa  @relation(fields: [companyId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  turmas  Turma[]

  /// SPEC-040 — alvo da FK composta de `disponibilidades_professor`. Entrou
  /// tarde porque, ate a agenda do professor existir, nada apontava para a
  /// ficha dele carregando a empresa junto.
  disponibilidades DisponibilidadeProfessor[]
  /// SPEC-039 — as aulas particulares deste professor.
  ocupacoes        OcupacaoQuadra[]

  @@unique([companyId, id], map: "professores_company_id_id_key")
  @@index([companyId])
  @@map("professores")
}

model Aluno {
  id            String        @id @default(uuid()) @db.Uuid
  usuarioId     String        @unique @map("usuario_id") @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  saldoCreditos Int           @default(0) @map("saldo_creditos")
  nivelId       String?       @map("nivel_id") @db.Uuid
  status        UsuarioStatus @default(ativo)
  // SPEC-009/REQ-008: `status` (ativo/inativo) e desligamento de um aluno
  // que ja opera; `vinculo` e outra coisa — se a empresa reconhece esta
  // pessoa. Fonte de verdade de INV-010, lida do banco no momento da
  // escrita, nunca do JWT (2a validacao cruzada, ACHADO-003).
  vinculo       VinculoAluno  @default(pendente)

  /// SPEC-036 — os sete campos do CADASTRO COMPLETO, e o fim do GAP-002.
  ///
  /// **Aqui e nao em `usuarios` (D1):** `usuarios` e quem ENTRA, `alunos` e a
  /// FICHA no clube. Em `usuarios`, estas sete seriam colunas nulas em toda
  /// conta de gestor e de professor, com um CHECK por papel para defende-las.
  ///
  /// **Todas anulaveis, e e o unico jeito:** ha alunos em producao. E
  /// `NOT NULL DEFAULT ''` transformaria "nao informado" em "informado
  /// vazio", que e o que o `alunos_texto_nao_vazio` impede daqui pra frente.
  ///
  /// **Nao existe coluna de completude, e a ausencia e a decisao**
  /// (D2/INV-111): a SPEC-037 acrescenta plano e contrato a matricula, e no
  /// dia em que isso entrar toda percentagem gravada estaria errada.
  ///
  /// **Sem CPF** (LIM-036a): o dinheiro nao passa pela plataforma, e
  /// documento que nada usa e passivo.
  dataNascimento     DateTime? @map("data_nascimento") @db.Date
  emergenciaNome     String?   @map("emergencia_nome")
  emergenciaTelefone String?   @map("emergencia_telefone")
  endereco           String?
  cidade             String?
  /// CHAR(2), e o CHECK `alunos_uf_valida` cobra a lista das 27 — duas letras
  /// maiusculas nao bastam, `XX` passaria.
  uf                 String?   @db.Char(2)
  observacoesSaude   String?   @map("observacoes_saude")

  createdAt DateTime @default(now()) @map("created_at")

  /// DEF-024 fase 1 — IDENTIDADE, nao autoria: a LIM-032f protege o autor
  /// `super_admin` (que tem `company_id` nulo), e um super admin nunca e
  /// aluno. Sem a empresa na chave, a ficha de um aluno da empresa A podia
  /// apontar para o usuario da B.
  movimentosDeCredito MovimentoDeCredito[]
  usuario             Usuario              @relation(fields: [companyId, usuarioId], references: [companyId, id], onDelete: Cascade, map: "alunos_usuario_fkey")
  empresa             Empresa              @relation(fields: [companyId], references: [id])
  /// SPEC-075/D9 — FK composta, e `RESTRICT`: um nivel em uso por aluno nao
  /// se apaga (o servico ja recusava; o banco passa a garantir).
  nivel               Nivel?               @relation(fields: [companyId, nivelId], references: [companyId, id], onDelete: Restrict, map: "alunos_nivel_fkey")
  ocupacoes           OcupacaoQuadra[]
  turmaAlunos         TurmaAluno[]
  faltasAvisadas      FaltaAvisada[]
  reposicoesDeAula    ReposicaoDeAula[]
  eventosDeMatricula  EventoDeMatricula[]
  avaliacoes          AvaliacaoDeAula[]
  presencas           Presenca[]
  matriculas          Matricula[]
  /// SPEC-064 — as linhas da fila de espera do aluno (`fila_aluno_fkey`,
  /// RESTRICT: apagar aluno com fila viva e erro, nao limpeza silenciosa).
  filaDeEspera        ListaDeEspera[]
  /// SPEC-074 — os pedidos de aviso de horario do aluno
  /// (`pre_reserva_aluno_fkey`, RESTRICT, pelo mesmo motivo da fila).
  preReservas         PreReserva[]

  /// DEF-024 fase 1 — alvo das FKs compostas de `presencas` e
  /// `avaliacoes_de_aula`. `id` ja e PK, entao este UNIQUE nunca falha por
  /// duplicata: ele existe so para o `REFERENCES` de duas colunas ter onde se
  /// apoiar. Mesmo papel do `quadras_company_id_id_key` (DEF-022).
  @@unique([companyId, id], map: "alunos_company_id_id_key")
  /// Este segundo UNIQUE existe por exigencia do PRISMA, nao do dominio: o
  /// lado definidor de uma relacao 1:1 precisa de unique sobre os campos da
  /// relacao. Ele e IMPLICADO pelo `alunos_usuario_id_key`, que ja existe —
  /// se `usuario_id` e unico, `(company_id, usuario_id)` tambem e. Fica
  /// documentado para ninguem procurar a regra de negocio que ele exprime:
  /// nao ha nenhuma.
  @@unique([companyId, usuarioId], map: "alunos_company_id_usuario_id_key")
  @@index([companyId])
  @@map("alunos")
}

enum QuadraStatus {
  ativa
  inativa

  @@map("quadra_status")
}

/// SPEC-020 — o catalogo de esportes do clube.
///
/// Molde de `Nivel`: `(company_id, nome, ordem)`, unico por empresa. Cada
/// clube define o seu porque "saibro" e "terra batida" sao a mesma coisa com
/// nomes diferentes por regiao, e um clube de beach tennis nao tem nada a ver
/// com a lista de um clube de tenis (decisao 2).
///
/// O `@@unique([companyId, id])` e redundante como chave — `id` ja e PK — e
/// existe para ser o alvo da FK COMPOSTA de `quadras` (INV-054). E o mesmo
/// truque de `ocupacoes_quadra.@@unique([id, origemTipo])`, que ja sustenta
/// a INV-016.
model EsporteDeQuadra {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa  @relation(fields: [companyId], references: [id])
  quadras Quadra[]

  @@unique([companyId, nome])
  @@unique([companyId, id], map: "esportes_de_quadra_company_id_id_key")
  @@index([companyId])
  @@map("esportes_de_quadra")
}

/// SPEC-020 — o catalogo de categorias (piso) do clube: terra, sintetica,
/// rapida. Mesma forma do de esportes, e opcional na quadra: nem todo clube
/// classifica piso, e obrigar criaria uma categoria "Outros" em todo clube
/// que nao classifica (decisao 3).
model CategoriaDeQuadra {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa  @relation(fields: [companyId], references: [id])
  quadras Quadra[]

  @@unique([companyId, nome])
  @@unique([companyId, id], map: "categorias_de_quadra_company_id_id_key")
  @@index([companyId])
  @@map("categorias_de_quadra")
}

model Quadra {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  nome      String
  precoHora Decimal      @map("preco_hora") @db.Decimal(10, 2)
  status    QuadraStatus @default(ativa)
  createdAt DateTime     @default(now()) @map("created_at")

  /// SPEC-018/TASK-001 — imagem PUBLICA da quadra (decisao 1, opcao B).
  /// As tres colunas abaixo vivem e morrem juntas, garantido por CHECK
  /// escrito a mao (`quadras_imagem_confirmada_check`): nao existe imagem
  /// sem alguem tendo afirmado, com nome e data, que ela nao mostra pessoa
  /// identificavel (AC-007/008). Trocar a imagem regrava as tres.
  imagemKey           String?   @map("imagem_key")
  imagemConfirmadaPor String?   @map("imagem_confirmada_por") @db.Uuid
  imagemConfirmadaEm  DateTime? @map("imagem_confirmada_em")

  /// SPEC-020/TASK-004 — a fase CONTRACT fechou: `esporte_id` e obrigatoria
  /// e a coluna de texto nao existe mais. Toda quadra aponta para o catalogo
  /// da propria empresa, garantido pela FK composta abaixo.
  esporteId   String  @map("esporte_id") @db.Uuid
  /// Opcional por decisao de produto (AC-006): nem todo clube classifica
  /// piso, e obrigar criaria uma categoria "Outros" em todo clube que nao
  /// classifica — "Outros" como filtro e ruido.
  categoriaId String? @map("categoria_id") @db.Uuid

  /// SPEC-057/TASK-005/D19 — cor AUXILIAR da quadra na agenda, de uma paleta
  /// fixa de seis (CHECK `quadras_cor_paleta_check`, forma canônica maiúscula).
  /// Nunca é o único identificador (INV-140): a tela sempre escreve nome + Q-código.
  cor          String @default("#00763A") @db.VarChar(7)
  /// SPEC-057/TASK-005/D19 — código visível e único que desambigua quadras
  /// homônimas. No banco é `GENERATED ALWAYS AS IDENTITY` (a migration é a
  /// fonte); `autoincrement()` aqui só diz ao Prisma que ele NÃO escreve a
  /// coluna. A API não permite editá-lo.
  codigoAgenda Int    @unique(map: "quadras_codigo_agenda_key") @default(autoincrement()) @map("codigo_agenda")

  empresa      Empresa                @relation(fields: [companyId], references: [id])
  /// INV-054 — **FK COMPOSTA**, e e ela que impede apontar para o esporte de
  /// outra empresa. FK simples nao saberia de `company_id`; aqui, como a
  /// coluna de escopo da quadra E a mesma da FK, o banco so fecha o vinculo
  /// dentro da propria empresa. Sem trigger, sem codigo.
  ///
  /// Depois da TASK-004 `esporte_id` e NOT NULL, entao a FK sempre dispara.
  /// `categoria_id` continua nulavel, e ali o MATCH SIMPLE segue valendo:
  /// quadra sem categoria nao tem vinculo a conferir.
  esporteRef   EsporteDeQuadra        @relation(fields: [companyId, esporteId], references: [companyId, id], map: "quadras_esporte_fkey")
  categoriaRef CategoriaDeQuadra?     @relation(fields: [companyId, categoriaId], references: [companyId, id], map: "quadras_categoria_fkey")
  /// `Restrict`, igual a `chamadas.registrada_por`: a confirmacao vale por
  /// ter nome de gente, entao apagar a conta nao pode apagar o autor.
  confirmante  Usuario?               @relation("QuadraImagemConfirmadaPor", fields: [imagemConfirmadaPor], references: [id], onDelete: Restrict)
  ocupacoes    OcupacaoQuadra[]
  turmas       Turma[]
  horarios     HorarioFuncionamento[]
  /// SPEC-074 — os pedidos de aviso de horario nesta quadra
  /// (`pre_reserva_quadra_fkey`, RESTRICT).
  preReservas  PreReserva[]

  /// INV-054b (DEF-022) — o alvo das FKs compostas que apontam para quadra.
  /// `id` já é PK, então isto não muda o que é único: existe para que
  /// `ocupacoes_quadra`, `turmas` e `horarios_funcionamento` possam referenciar
  /// `(company_id, id)` e o banco recusar vínculo entre empresas diferentes.
  /// Mesmo papel do `@@unique` que `esportes_de_quadra` já tinha para a
  /// INV-054.
  @@unique([companyId, id], map: "quadras_company_id_id_key")
  @@index([companyId])
  @@index([imagemConfirmadaPor])
  @@map("quadras")
}

enum OrigemTipo {
  TURMA
  AVULSO

  @@map("origem_tipo")
}

enum StatusPagamento {
  pendente_pagamento
  pago
  cancelado

  @@map("status_pagamento")
}

// Tabela mais crítica do domínio (ADR-009, INV-001) — ver a constraint
// `EXCLUDE USING gist` adicionada manualmente na migration (não
// expressável no schema.prisma) logo abaixo do CREATE TABLE gerado.
model OcupacaoQuadra {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  quadraId           String          @map("quadra_id") @db.Uuid
  data               DateTime        @db.Date
  horaInicio         DateTime        @map("hora_inicio") @db.Time
  horaFim            DateTime        @map("hora_fim") @db.Time
  origemTipo         OrigemTipo      @map("origem_tipo")
  origemTurmaId      String?         @map("origem_turma_id") @db.Uuid
  /// SPEC-039 — a aula particular. **Nao e um `origem_tipo` novo** (D1): a
  /// ocupacao continua `AVULSO`, e o professor e ATRIBUTO dela. Um terceiro
  /// valor no enum quebraria a FK de 4 colunas da carteira e o
  /// `CHECK ocupacoes_valor_por_origem` -- ver o comentario da migration.
  professorId        String?         @map("professor_id") @db.Uuid
  alunoId            String?         @map("aluno_id") @db.Uuid
  statusPagamento    StatusPagamento @default(pendente_pagamento) @map("status_pagamento")
  /// SPEC-011: quanto foi cobrado, congelado na criação. **Nulo para
  /// origem TURMA** — aula recorrente não tem cobrança própria (CON-006),
  /// e `NOT NULL` global quebraria a criação de turma. Garantido por CHECK
  /// escrito à mão na migration.
  valor              Decimal?        @db.Decimal(10, 2)
  /// SPEC-011: agrupa os blocos criados por um mesmo pedido. Nulo em
  /// linhas anteriores à spec e em ocupações de turma.
  pedidoId           String?         @map("pedido_id") @db.Uuid
  /// Mecanismo de idempotência anterior à SPEC-011, mantido para as linhas
  /// já criadas. Escrita nova deixa nulo e usa `pedidoId`.
  clientRequestId    String?         @map("client_request_id")
  /// SPEC-032/INV-064 — a IDENTIDADE DA TRANSICAO, trocada a cada mudanca de
  /// estado. Nulavel porque as linhas anteriores a spec nunca tiveram uma
  /// (LIM-032a): so entra na exigencia quando alguem cancelar.
  ///
  /// A versao anterior da invariante usava `criado_em >=
  /// transaction_timestamp()` e caiu por dois caminhos: o timestamp e o
  /// INICIO da transacao, nao a identidade dela (o evento de uma transacao
  /// concorrente satisfazia a outra), e `cancelar -> reativar -> cancelar` na
  /// mesma transacao passava com um evento so.
  transicaoId        String?         @map("transicao_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  /// SPEC-054/D5 — o id da transação que criou a ocupação. **Nenhum código o
  /// escreve:** a trigger `ocupacao_marca_transacao_de_criacao` grava
  /// `txid_current()` ignorando o valor enviado, e outra trigger recusa mudá-lo.
  /// O default fica como documentação; o mecanismo é a trigger. Nulo = reserva
  /// anterior à migration, que não pode ganhar adicional.
  transacaoDeCriacao BigInt?         @default(dbgenerated("txid_current()")) @map("transacao_de_criacao")

  empresa             Empresa              @relation(fields: [companyId], references: [id])
  /// DEF-022 (validação cruzada da SPEC-026, achado 3) — **FK COMPOSTA.**
  ///
  /// Era `references: [id]`, simples. O banco aceitava ocupação com
  /// `company_id = A` apontando para quadra da empresa B, e o detalhe do dia
  /// devolvia `quadraNome` alheio. Não havia caminho de produto que criasse
  /// isso — mas a INV-054 já tinha ensinado que "não há caminho hoje" não é
  /// a mesma coisa que "o banco não deixa", e foi exatamente por confiar
  /// nisso que a SPEC-025 vazou nota de turma entre empresas.
  quadra              Quadra               @relation(fields: [companyId, quadraId], references: [companyId, id], onDelete: Restrict, map: "ocupacoes_quadra_quadra_fkey")
  aluno               Aluno?               @relation(fields: [alunoId], references: [id])
  /// FK COMPOSTA (DEF-024). `Restrict` de proposito: apagar professor nao pode
  /// apagar aula prestada e paga com credito -- difere da
  /// `disponibilidades_professor`, que e configuracao e cai por cascata.
  professor           Professor?           @relation(fields: [companyId, professorId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "ocupacoes_professor_fkey")
  movimentosDeCredito MovimentoDeCredito[]
  pedido              PedidoReserva?       @relation(fields: [pedidoId], references: [id])
  // `onDelete: Restrict` declarado explicitamente para casar com o que a
  // migration 20260812000000_classes aplicou à mão no banco. Sem isso o
  // Prisma assume `SET NULL` (default de relação opcional) e acusa drift,
  // querendo reescrever a FK — e `SET NULL` seria errado no domínio:
  // apagar uma turma deixaria ocupações órfãs na linha do tempo da quadra,
  // sem dono, contrariando INV-001. Drift encontrado em SPEC-009:TASK-000.
  /// SPEC-025 / validacao cruzada, achado 1 — a FK carrega a EMPRESA.
  /// Mesmo padrao de `quadras.esporteRef`/`categoriaRef`: sem a empresa na
  /// chave, o banco aceitaria ocupacao de uma empresa apontando para turma
  /// de outra, e a media da turma agregaria nota alheia.
  origemTurma         Turma?               @relation(fields: [companyId, origemTurmaId], references: [companyId, id], onDelete: Restrict, map: "ocupacoes_quadra_origem_turma_fkey")
  avaliacoes          AvaliacaoDeAula[]

  presencas         Presenca[]
  eventos           EventoDeOcupacao[]
  /// Duas relacoes para a MESMA tabela: a FK de `origem_tipo` (INV-067) e a
  /// de tenant. `ocupacoes_quadra` nao tem `UNIQUE (company_id, id,
  /// origem_tipo)`, entao as duas responsabilidades nao cabem numa so.
  faltasPorTipo     FaltaAvisada[]        @relation("FaltaOcupacaoTipo")
  faltas            FaltaAvisada[]        @relation("FaltaOcupacaoEmpresa")
  reposicoesPorTipo ReposicaoDeAula[]     @relation("ReposicaoOcupacaoTipo")
  reposicoes        ReposicaoDeAula[]     @relation("ReposicaoOcupacaoEmpresa")
  /// SPEC-054/INV-132 — as mesmas duas responsabilidades: tenant e avulsa.
  adicionaisPorTipo AdicionalDaOcupacao[] @relation("AdicionalOcupacaoTipo")
  adicionais        AdicionalDaOcupacao[] @relation("AdicionalOcupacaoEmpresa")
  // Prisma exige unicidade do par `(id, origem_tipo)` para modelar 1-1, e
  // criar esse UNIQUE seria um índice redundante — `ocupacao_id` já é PK de
  // `chamadas`. Então aqui o tipo é lista e **o banco é que garante uma
  // chamada por ocorrência**, pela PK. Mesmo caminho de `presencas`.
  chamadas          Chamada[]
  /// SPEC-064 — a fila de espera por VAGA DE REPOSICAO nesta aula. E a
  /// outra metade da D1: direito diferente, gatilho diferente.
  filaDeEspera      ListaDeEspera[]

  @@unique([id, origemTipo], map: "ocupacoes_quadra_id_origem_tipo_key")
  /// SPEC-032 — alvo da FK composta de `eventos_de_ocupacao`. Redundante como
  /// chave (`id` ja e PK); existe porque o Postgres nao infere alvo composto a
  /// partir de PK simples. Mesmo truque de `quadras_company_id_id_key`.
  @@unique([companyId, id], map: "ocupacoes_quadra_company_id_id_key")
  @@unique([companyId, id, alunoId, origemTipo], map: "ocupacoes_quadra_company_id_id_aluno_id_origem_key")
  @@index([companyId, quadraId, data])
  @@map("ocupacoes_quadra")
}

enum TurmaStatus {
  ativa
  inativa

  @@map("turma_status")
}

// Horário recorrente semanal fixo por turma no MVP (DATA_MODEL.md). Nunca
// escreve em `ocupacoes_quadra` diretamente — só através do método público
// `CourtsService.registerClassOccupancy(...)` (MOD-005 continua dono
// exclusivo da linha do tempo da quadra, TARGET_ARCHITECTURE.md seção 6).
model Turma {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  nome        String
  nivelId     String?     @map("nivel_id") @db.Uuid
  professorId String?     @map("professor_id") @db.Uuid
  quadraId    String      @map("quadra_id") @db.Uuid
  /// SPEC-019/TASK-003 — `dia_semana`, `hora_inicio` e `hora_fim` SAIRAM
  /// daqui. A recorrencia da turma e `encontros`, e ela cabe 1..N dias.
  ///
  /// Elas nao ficaram como "o primeiro encontro": duas fontes para a mesma
  /// pergunta e o que a SPEC-020 passou um dia inteiro desfazendo, e uma
  /// turma de tres dias que expusesse so o primeiro mentiria sobre si mesma.
  capacidade  Int
  status      TurmaStatus @default(ativa)
  createdAt   DateTime    @default(now()) @map("created_at")

  empresa   Empresa          @relation(fields: [companyId], references: [id])
  /// SPEC-075/D9 — FK composta, e `RESTRICT`: com o nivel decidindo acesso,
  /// o `SET NULL` de antes abriria a turma restrita a todos ao apagar o nivel.
  nivel     Nivel?           @relation(fields: [companyId, nivelId], references: [companyId, id], onDelete: Restrict, map: "turmas_nivel_fkey")
  professor Professor?       @relation(fields: [professorId], references: [id])
  /// DEF-022 — FK composta, mesmo motivo de `ocupacoes_quadra.quadra`: turma
  /// da empresa A não pode ser marcada numa quadra da empresa B.
  quadra    Quadra           @relation(fields: [companyId, quadraId], references: [companyId, id], onDelete: Restrict, map: "turmas_quadra_fkey")
  alunos    TurmaAluno[]
  ocupacoes OcupacaoQuadra[]
  encontros TurmaEncontro[]
  /// SPEC-064 — a fila de espera por VAGA DE MATRICULA nesta turma.
  filaDeEspera ListaDeEspera[]

  /// SPEC-025 / validacao cruzada — o alvo da FK composta de
  /// `ocupacoes_quadra`. Sem ele, o banco aceitava ocupacao de uma empresa
  /// apontando para turma de outra.
  eventosDeMatricula EventoDeMatricula[]

  /// SPEC-069 — o extrato administrativo DESTA turma. Nao e a historia
  /// completa dela (LIM-069a): os gestos de grade continuam em
  /// `eventos_de_ocupacao`.
  eventosDeTurma EventoDeTurma[]

  @@unique([companyId, id], map: "turmas_company_id_id_key")
  @@index([companyId])
  @@index([quadraId])
  @@map("turmas")
}

/// SPEC-019/TASK-001 — os encontros semanais da turma, um por dia.
///
/// **Fase EXPAND.** As tres colunas de `turmas` (`dia_semana`, `hora_inicio`,
/// `hora_fim`) continuam existindo e sao a fonte ate a TASK-002 passar a
/// escrever aqui. Elas so saem na TASK-003 (contract), e la a migration
/// aborta antes de qualquer `DROP` se o backfill nao tiver fechado.
///
/// ## Por que tabela filha, e nao um array de dias
///
/// **O horario pode variar por dia** (decisao do Israel, 2026-08-26). Um
/// `Int[]` de dias forcaria o mesmo horario em todos, e a primeira turma que
/// treina 18h na terca e 7h no sabado quebraria o modelo.
///
/// ## A exclusao se declara AQUI, nao depois
///
/// `onDelete: Cascade` e **sem `company_id`** — o mesmo padrao de
/// `TurmaAluno`. O `limpar-empresa.ts` documenta por que `turma_alunos` nao
/// aparece em `TABELAS_DA_EMPRESA`: nao tem `company_id` e cai por cascata de
/// `turmas`.
///
/// **Isto esta escrito porque ja quebrou tres vezes na SPEC-020:** tabela
/// nova por empresa com FK `RESTRICT` derruba toda limpeza escrita a mao, e o
/// sintoma chega como uma suite inteira vermelha com erro de constraint que
/// nao tem nada a ver com o teste.
///
/// ## O que o banco garante, e o que ele nao garante
///
/// - **`hora_fim > hora_inicio`**: CHECK escrito a mao na migration.
/// - **Um encontro por dia na mesma turma**: `@@unique([turmaId, diaSemana])`.
///   Duas aulas no MESMO dia da mesma turma sao um caso que a AC-007 aceita,
///   entao esta UNIQUE **nao** existe — ver a migration.
/// - **Turma com >= 1 encontro (INV-051)**: **o banco NAO garante.** Postgres
///   nao expressa "pai com pelo menos um filho" sem trigger, e este projeto
///   tem zero. Fica com a API e a transacao, declarado em vez de prometido —
///   ver a 1a rodada de duvida da SPEC-019.
model TurmaEncontro {
  id         String   @id @default(uuid()) @db.Uuid
  turmaId    String   @map("turma_id") @db.Uuid
  /// 0 = domingo, 6 = sabado — mesma convencao de `turmas.dia_semana` e de
  /// `horarios_funcionamento`.
  diaSemana  Int      @map("dia_semana")
  horaInicio DateTime @map("hora_inicio") @db.Time
  horaFim    DateTime @map("hora_fim") @db.Time
  createdAt  DateTime @default(now()) @map("created_at")

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
  @@map("turma_encontros")
}

// Alocação many-to-many aluno<->turma (DATA_MODEL.md). Contagem por
// turma_id nunca excede turmas.capacidade (INV-003) — checado em
// transação com `SELECT ... FOR UPDATE` na linha da turma, não só pela
// UNIQUE(turma_id, aluno_id) abaixo (que só evita duplicata do mesmo
// aluno, não estoura de capacidade).
// SPEC-014: os tres estados possiveis de um aluno numa aula. `justificado`
// e um **estado**, nao um documento — atestado e anexo estao fora de escopo
// de proposito.
enum StatusPresenca {
  presente
  ausente
  justificado

  @@map("status_presenca")
}

enum CompletudeChamada {
  completa
  desconhecida
  // SPEC-030: acrescentado **no fim**, pela mesma razao que `professor` em
  // `UsuarioRole` — `ALTER TYPE ADD VALUE` sem `BEFORE`/`AFTER` anexa ao
  // final, e declarar aqui em outra posicao criaria drift permanente.
  // Segunda vez que esta regra governa este arquivo.
  //
  // `nao_houve` NAO e "chamada vazia": e a afirmacao de que a aula nao
  // aconteceu. Por isso `esperados` e nulo (CHECK) e nao ha linha em
  // `presencas` (INV-030a) — nao ha universo sobre o qual afirmar.
  nao_houve

  @@map("completude_chamada")
}

/// SPEC-015/DEF-002/INV-027 — o cabeçalho da chamada.
///
/// A SPEC-014 modelou as **linhas** da chamada (`presencas`) e nao o **fato**
/// dela. Sem cabecalho, duas linhas em `presencas` significam tanto "chamada
/// completa de uma turma de 2" quanto "chamada pela metade de uma turma de
/// 10" — e foi por isso que a chamada parcial pode ser gravada e ficou sem
/// conserto pelo produto.
///
/// `completude = desconhecida` marca as chamadas anteriores a correcao. Nao e
/// estado transitorio: e a unica afirmacao verdadeira possivel sobre elas.
model Chamada {
  // PK e parte da FK composta: uma chamada por ocorrencia, com a
  // cardinalidade vindo do banco.
  ocupacaoId String     @id @map("ocupacao_id") @db.Uuid
  // Coluna constante, igual a `presencas`: com o CHECK e a FK composta,
  // impede cabecalho apontando reserva avulsa (INV-016).
  origemTipo OrigemTipo @map("origem_tipo")

  companyId                String            @map("company_id") @db.Uuid
  registradaEm             DateTime          @default(now()) @map("registrada_em")
  /// SPEC-057/TASK-001/D1 — NULO só na chamada automática (CHECK
  /// `chamadas_origem_autor_check`): o worker não é pessoa, e um usuário
  /// "sistema" seria autor inventado.
  registradaPor            String?           @map("registrada_por") @db.Uuid
  updatedAt                DateTime          @updatedAt @map("updated_at")
  /// SPEC-057/TASK-001/D1 — quem respondeu pela chamada POR ÚLTIMO:
  /// `automatica`, `professor`, `gestor` ou `legada_humana` (tudo que existia
  /// antes). Domínio por CHECK; texto e não enum Prisma, para a expansão não
  /// exigir `ALTER TYPE`.
  origem                   String            @default("legada_humana")
  /// SPEC-057/TASK-001/D1 — como a chamada NASCEU. Não muda na ratificação
  /// (imutabilidade de aplicação, LIM-057j).
  origemInicial            String            @default("legada_humana") @map("origem_inicial")
  /// SPEC-057/TASK-001/D5 — relógio do BANCO no fechamento automático; ancora
  /// os sete dias de correção. CHECK + trigger: existe exatamente quando
  /// `origemInicial` é `automatica`, e não muda depois de gravado.
  fechadaAutomaticamenteEm DateTime?         @map("fechada_automaticamente_em") @db.Timestamptz(6)
  completude               CompletudeChamada
  /// Nulo quando `completude` e `desconhecida` **ou `nao_houve`** (SPEC-030),
  /// garantido por CHECK escrito a mao na migration: quem afirma completude
  /// diz sobre quantos, e quem diz que a aula nao aconteceu nao afirma sobre
  /// ninguem. O CHECK enumera os tres casos um a um, de proposito — ver
  /// `20260830100100_spec030_check_esperados_nao_houve`.
  esperados                Int?

  empresa     Empresa        @relation(fields: [companyId], references: [id])
  ocupacao    OcupacaoQuadra @relation(fields: [ocupacaoId, origemTipo], references: [id, origemTipo], onDelete: Cascade, map: "chamadas_ocupacao_fkey")
  registrante Usuario?       @relation("ChamadaRegistradaPor", fields: [registradaPor], references: [id], onDelete: Restrict)
  presencas   Presenca[]

  @@index([companyId])
  @@map("chamadas")
}

model Presenca {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  // SPEC-014/INV-016 imposta **pelo banco**, nao por codigo: `origemTipo` e
  // uma coluna constante ('TURMA', garantido por CHECK) que participa da FK
  // composta para `ocupacoes_quadra(id, origem_tipo)`. Assim o Postgres
  // recusa presenca apontando reserva avulsa — nao ha caminho pelo qual
  // codigo errado consiga gravar. A parte "nao cancelada" da INV-016 fica
  // no servico, e isso e deliberado: e regra de **escrita**, e cancelar
  // depois nao desfaz quem esteve la (AC-012).
  ocupacaoId String     @map("ocupacao_id") @db.Uuid
  origemTipo OrigemTipo @map("origem_tipo")

  alunoId       String         @map("aluno_id") @db.Uuid
  status        StatusPresenca
  /// SPEC-057/TASK-001/D1 — nulo nas linhas do fechamento automático.
  registradoPor String?        @map("registrado_por") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  empresa     Empresa        @relation(fields: [companyId], references: [id])
  // `map:` declara o nome que a migration deu à FK. Sem isso o Prisma quer
  // renomeá-la para o padrão dele a cada `migrate diff`, e o drift nunca
  // fecha. A migration já foi aplicada em produção: editá-la agora quebraria
  // o checksum que o Prisma guarda, então quem se ajusta é o schema.
  ocupacao    OcupacaoQuadra @relation(fields: [ocupacaoId, origemTipo], references: [id, origemTipo], onDelete: Cascade, map: "presencas_ocupacao_fkey")
  // SPEC-015/INV-027 (fase `contract`): presenca sem cabecalho passa a ser
  // impossivel **no banco**. NoAction e nao Restrict porque apagar a
  // ocorrencia cascateia para as duas tabelas na mesma instrucao — Restrict
  // e checado na hora e abortaria; NoAction e checado no fim.
  chamada     Chamada        @relation(fields: [ocupacaoId], references: [ocupacaoId], onDelete: NoAction, map: "presencas_chamada_fkey")
  /// DEF-024 fase 1 — era a FK que a SPEC-031 apontou: a v3 dela dizia
  /// nascer "no molde de `presencas`", e o molde nao carregava a empresa.
  aluno       Aluno          @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, map: "presencas_aluno_fkey")
  registrante Usuario?       @relation("PresencaRegistradaPor", fields: [registradoPor], references: [id], onDelete: Restrict)

  // INV-015: um aluno tem no maximo um registro por aula.
  @@unique([ocupacaoId, alunoId])
  @@index([companyId, ocupacaoId])
  @@index([alunoId])
  @@map("presencas")
}

model TurmaAluno {
  id        String   @id @default(uuid()) @db.Uuid
  turmaId   String   @map("turma_id") @db.Uuid
  alunoId   String   @map("aluno_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([turmaId, alunoId])
  @@index([turmaId])
  @@index([alunoId])
  @@map("turma_alunos")
}

// MOD-006 (SPEC-006): configuração de como a empresa recebe pagamento
// (link externo e/ou WhatsApp) — regra de "pelo menos um preenchido" é
// validada na aplicação, não em CHECK de banco (DATA_MODEL.md, regra de
// produto pode mudar mais fácil que constraint).
model ConfigPagamentoEmpresa {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @unique @map("company_id") @db.Uuid
  linkPagamentoUrl String?  @map("link_pagamento_url")
  whatsappNumero   String?  @map("whatsapp_numero")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [companyId], references: [id])

  @@map("config_pagamento_empresa")
}

// SPEC-009/REQ-002 (MOD-001): convite de uso unico para o aluno criar a
// propria senha, encaminhado por WhatsApp pelo admin.
//
// `tokenHash` e `sha256` deterministico do token aleatorio de 32 bytes —
// **nunca bcrypt**. Aqui o token e a chave de busca da claim atomica de
// INV-009 (`UPDATE ... WHERE token_hash = ? AND usado_em IS NULL`), e
// bcrypt tem salt por hash, entao a busca por igualdade nunca casaria.
// Isso diverge de propósito do padrao de `refresh_tokens`, onde a linha e
// achada por `jti` e o hash so e comparado depois (achado NOVO-001 da 2a
// validacao cruzada). Com 256 bits de entropia, sha256 sem salt nao e
// forca-bruta-vel.
model ConviteAluno {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  criadoPorId String    @map("criado_por_id") @db.Uuid
  // Pre-preenchimento feito pelo admin. `nome` aparece na tela publica
  // (AC-024); `email`, `telefone` e `nivelId` sao aplicados no aceite sem
  // serem exibidos (AC-025).
  email       String?
  nome        String?
  telefone    String?
  nivelId     String?   @map("nivel_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiraEm    DateTime  @map("expira_em")
  usadoEm     DateTime? @map("usado_em")
  createdAt   DateTime  @default(now()) @map("created_at")

  empresa   Empresa @relation(fields: [companyId], references: [id])
  criadoPor Usuario @relation("ConviteCriadoPor", fields: [criadoPorId], references: [id])
  /// SPEC-075/D9 — **o banco faz `ON DELETE SET NULL (nivel_id)`, com a
  /// coluna NOMEADA, e o Prisma NAO SABE ESCREVER ISSO** (o mesmo caso de
  /// `ListaDeEspera.falta`, SPEC-064). O `SetNull` que o Prisma gera anularia
  /// tambem `company_id`, que e NOT NULL, e o DELETE do nivel morreria com
  /// `23502`. Aqui vai `NoAction`, que e o que o Prisma consegue dizer; a acao
  /// real esta na migration `20260925200000_spec075_nivel_por_empresa`. **Nao
  /// rode `prisma migrate dev` sobre este modelo esperando reproduzir o banco.**
  nivel     Nivel?  @relation(fields: [companyId, nivelId], references: [companyId, id], onDelete: NoAction, onUpdate: Cascade, map: "convites_nivel_fkey")
  /// SPEC-037/D8 — o convite carrega o plano, e e ai que a jornada fecha: o
  /// gestor convida ja dizendo qual, e o aceite cria conta + aceite do
  /// contrato + MATRICULA na mesma transacao (AC-015).
  ///
  /// Opcional: convite sem plano continua sendo o de hoje. FK **composta**
  /// (DEF-024), senao o convite da empresa A poderia apontar para plano da B.
  planoId   String? @map("plano_id") @db.Uuid
  plano     Plano?  @relation(fields: [companyId, planoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "convites_plano_fkey")

  @@index([companyId])
  @@map("convites_aluno")
}

// SPEC-010/REQ-001..003 (MOD-005) — horário de funcionamento por dia da
// semana.
//
// `quadraId` nulo = **padrão da empresa**; preenchido = horário próprio
// daquela quadra, que sobrepõe o padrão naquele dia. Quadra que segue o
// padrão **não tem linha aqui**: a herança é ausência de registro, não
// cópia de valores — é isso que faz mudar a configuração da empresa
// alcançar todas as quadras sem escrever em nenhuma.
//
// As constraints que valem de verdade são escritas à mão na migration,
// porque o Prisma não as expressa:
//  - `UNIQUE NULLS NOT DISTINCT (company_id, quadra_id, dia_semana)` — sem
//    o `NULLS NOT DISTINCT`, o Postgres considera NULL distinto de NULL e
//    o padrão da empresa poderia ser cadastrado duas vezes para o mesmo
//    dia;
//  - `CHECK` de coerência entre `fechado` e as horas;
//  - `CHECK` de hora cheia (REQ-008).
model HorarioFuncionamento {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  quadraId   String?   @map("quadra_id") @db.Uuid
  /// 0 = domingo, mesma convenção de `Date.getDay()` — evita tradução de
  /// índice entre banco e aplicação, que é erro que só aparece no domingo.
  diaSemana  Int       @map("dia_semana") @db.SmallInt
  horaInicio DateTime? @map("hora_inicio") @db.Time(0)
  horaFim    DateTime? @map("hora_fim") @db.Time(0)
  fechado    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [companyId], references: [id])
  /// DEF-022 — FK composta. `quadra_id` é nulável (linha da EMPRESA inteira),
  /// e o MATCH SIMPLE do Postgres não dispara quando qualquer coluna da chave
  /// é nula — então a regra da empresa continua funcionando exatamente como
  /// antes. `Cascade` preservado: apagar a quadra apaga o horário dela.
  quadra  Quadra? @relation(fields: [companyId, quadraId], references: [companyId, id], onDelete: Cascade, map: "horarios_funcionamento_quadra_fkey")

  // Declarado aqui para o Prisma não acusar drift (ele introspecta índices
  // únicos btree). O `NULLS NOT DISTINCT` — que é o que realmente impede
  // dois padrões da mesma empresa no mesmo dia — só existe no SQL da
  // migration: o Prisma não expressa essa cláusula.
  @@unique([companyId, quadraId, diaSemana], map: "horarios_funcionamento_escopo_dia_key")
  @@index([companyId])
  @@index([quadraId])
  @@map("horarios_funcionamento")
}

// SPEC-011 (MOD-005) — um pedido de reserva pode gerar mais de uma
// ocupação: slots contíguos viram um bloco, separados viram blocos
// independentes. Esta tabela existe para a idempotência valer para o
// **pedido**, e não para cada linha criada.
//
// O `fingerprint` (sha256 do payload normalizado) é o que distingue um
// retry legítimo de um pedido diferente reusando a mesma chave. Sem ele,
// reenviar a mesma `clientRequestId` com outra seleção de horários seria
// indistinguível de repetição — e criaria reservas em silêncio.
model PedidoReserva {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  clientRequestId String   @map("client_request_id")
  fingerprint     String
  createdAt       DateTime @default(now()) @map("created_at")

  empresa   Empresa          @relation(fields: [companyId], references: [id])
  ocupacoes OcupacaoQuadra[]

  @@unique([companyId, clientRequestId])
  @@index([companyId])
  @@map("pedidos_reserva")
}

// SPEC-017/TASK-004 (MOD-008) — a fila de exclusão de objeto de storage.
//
// Chave por conteúdo (AC-007) cria um caso que a lógica ingênua "troquei,
// enfileiro a anterior" resolve errado: reenviar a mesma foto, ou trocar
// A -> B -> A, apagaria o objeto que acabou de virar o atual. Esta tabela
// é a segunda das três defesas — a primeira é não enfileirar chave igual
// (AC-013), a terceira é o advisory lock por chave (INV-039).
//
// **Não tem FK para `empresas`, e é a única tabela assim.** A fila precisa
// sobreviver à exclusão da empresa: é exatamente aí que há mais objeto
// para apagar. FK com RESTRICT impediria apagar a empresa; com CASCADE,
// apagaria a fila e deixaria o arquivo órfão no bucket para sempre. O
// `company_id` é amarrado à `key` por CHECK escrito à mão na migration
// (INV-030) — o vínculo é com o caminho do objeto, não com a linha.
model ArquivoPendenteExclusao {
  id String @id @default(uuid()) @db.Uuid

  /// `empresas/<company_id>/<tipo>/<recurso>/<sha256>.webp` (INV-030/035).
  /// Única: duas linhas para o mesmo objeto são ruído, e fariam a carência
  /// (AC-016b) e o teto por ciclo (AC-016c) contarem o mesmo arquivo duas
  /// vezes.
  key String @unique

  /// Redundante com o prefixo da `key` e amarrado a ele por CHECK. Existe
  /// porque o teto por empresa (AC-016c) é uma agregação, e agregação sobre
  /// `split_part()` não usa índice.
  companyId String @map("company_id") @db.Uuid

  /// Por que esta chave entrou na fila. Vai para o alerta de operação.
  motivo String

  /// Tentativas de exclusão que FALHARAM (AC-012/016). Conflito de lock
  /// **não** conta aqui — tem contador próprio, porque concorrência normal
  /// não é erro (AC-016d/INV-046).
  tentativas Int @default(0)

  ultimoErro String? @map("ultimo_erro")

  /// Base da carência de 1 hora (AC-016b): exclusão errada ganha uma janela
  /// em que alguém pode perceber.
  criadoEm DateTime @default(now()) @map("criado_em")

  /// AC-016d — contador do reagendamento por lock, separado de
  /// `tentativas`. Concorrência normal não é erro; concorrência eterna é
  /// estado degradado, e só o contador próprio distingue as duas.
  lockSkipCount      Int       @default(0) @map("lock_skip_count")
  lastLockConflictAt DateTime? @map("last_lock_conflict_at")

  @@index([criadoEm])
  @@index([companyId])
  @@map("arquivos_pendentes_exclusao")
}

// ---------------------------------------------------------------------------
// SPEC-024 — termo da plataforma e contrato da empresa
// ---------------------------------------------------------------------------

/// O termo de uso da PLATAFORMA. E nosso, igual para todo mundo, e vai no
/// deploy — por isso a versao e um numero, nao um hash do texto: hash mudaria
/// com uma virgula corrigida e obrigaria a base inteira a reaceitar por causa
/// de um typo. Publicar versao nova e ato deliberado.
model TermoDaPlataforma {
  versao      Int      @id
  texto       String
  publicadoEm DateTime @default(now()) @map("publicado_em")

  @@map("termos_da_plataforma")
}

/// O contrato da EMPRESA, escrito pelo gestor. Uma linha por versao
/// publicada — INV-024c: versao publicada nunca e editada.
model ContratoDaEmpresa {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  versao      Int
  texto       String
  publicadoEm DateTime @default(now()) @map("publicado_em")

  empresa Empresa @relation(fields: [companyId], references: [id])

  @@unique([companyId, versao], map: "contratos_da_empresa_company_versao_key")
  @@map("contratos_da_empresa")
}

enum TipoDeAceite {
  termo
  contrato

  @@map("tipo_de_aceite")
}

/// O REGISTRO LEGAL, e a razao desta spec existir.
///
/// Append-only por regra (INV-024a): nada aqui e apagado nem alterado. A
/// unicidade por (usuario, tipo, versao) e o que torna aceitar duas vezes
/// idempotente em vez de virar duas linhas — toque duplo em conexao ruim e o
/// caso real.
model Aceite {
  id        String       @id @default(uuid()) @db.Uuid
  usuarioId String       @map("usuario_id") @db.Uuid
  tipo      TipoDeAceite
  versao    Int
  aceitoEm  DateTime     @default(now()) @map("aceito_em")

  /// SPEC-037/D5 — **discriminante CONSTANTE**, o mesmo truque da SPEC-033.
  ///
  /// Vale `contrato` na linha de contrato e NULO na de termo. E o que permite
  /// a FK de `matriculas` exigir "o aceite e DO CONTRATO" sem uma trigger:
  /// sem ela, uma `UNIQUE (usuario_id, versao)` casaria tambem o aceite do
  /// TERMO de mesma versao, e a matricula apontaria para o aceite errado.
  ///
  /// `dbgenerated` porque o Prisma nao emite `GENERATED ALWAYS ... STORED` --
  /// ele viraria um `DEFAULT CASE` que o Postgres recusa com `0A000`. Quem
  /// cria a coluna e a migration; aqui esta a REPRESENTACAO.
  tipoContrato TipoDeAceite? @default(dbgenerated("\nCASE\n    WHEN (tipo = 'contrato'::tipo_de_aceite) THEN 'contrato'::tipo_de_aceite\n    ELSE NULL::tipo_de_aceite\nEND")) @map("tipo_contrato")

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  matriculas Matricula[]

  @@unique([usuarioId, tipo, versao], map: "aceites_usuario_tipo_versao_key")
  @@unique([usuarioId, tipoContrato, versao], map: "aceites_contrato_key")
  @@index([usuarioId])
  @@map("aceites")
}

/// SPEC-037 — o PLANO que o clube vende.
///
/// **Sem contador de versao, e a ausencia e a decisao (D3):** a matricula
/// congela valor e prazo, entao mudar o preco amanha nao reescreve o que foi
/// contratado ontem. Um `versao` que nada le seria cerimonia.
///
/// `linkPagamentoUrl` NULO = **herda da empresa** (D6), no molde de
/// `horarios_funcionamento`. Nao e "sem link".
model Plano {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  nome             String
  valorCentavos    Int      @map("valor_centavos")
  prazoMeses       Int      @map("prazo_meses")
  linkPagamentoUrl String?  @map("link_pagamento_url")
  /// Plano contratado nao e apagado (INV-115, FK RESTRICT): e desativado.
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa    Empresa        @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "planos_empresa_fkey")
  matriculas Matricula[]
  convites   ConviteAluno[]

  @@unique([companyId, id], map: "planos_company_id_id_key")
  @@index([companyId], map: "planos_company_idx")
  @@map("planos")
}

/// SPEC-037 — a MATRICULA, que e a terceira coisa que este projeto quase
/// chamou de matricula.
///
/// | O que existe | O que e |
/// |---|---|
/// | `turma_alunos` | o aluno esta NAQUELA turma |
/// | `alunos.vinculo` | o clube RECONHECE esta pessoa |
/// | **esta tabela** | esta pessoa CONTRATOU este plano, por este prazo, por este valor |
///
/// **`usuarioId` parece redundante com `alunoId` e nao e:** e a perna da FK do
/// aceite, porque `aceites` e por USUARIO -- quem assina e a pessoa, nao a
/// ficha. Sem ela a INV-114 nao teria como existir.
model Matricula {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  alunoId               String   @map("aluno_id") @db.Uuid
  usuarioId             String   @map("usuario_id") @db.Uuid
  planoId               String   @map("plano_id") @db.Uuid
  /// O que foi ACERTADO.
  valorCentavos         Int      @map("valor_centavos")
  /// O que o plano cobrava NAQUELE DIA (D2). Com os dois, o desconto fica
  /// visivel; com um so, ninguem distingue desconto de mudanca de preco.
  valorDeTabelaCentavos Int      @map("valor_de_tabela_centavos")
  prazoMeses            Int      @map("prazo_meses")
  inicio                DateTime @db.Date
  /// GRAVADO, nao derivado na leitura (D9): "quem vence este mes" viraria
  /// varredura com aritmetica de data.
  fim                   DateTime @db.Date
  contratoVersao        Int      @map("contrato_versao")
  criadoPorId           String   @map("criado_por_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Constante `contrato`, sempre. O lado que APONTA na FK causal.
  tipoContrato TipoDeAceite? @default(dbgenerated("\nCASE\n    WHEN (contrato_versao IS NOT NULL) THEN 'contrato'::tipo_de_aceite\n    ELSE NULL::tipo_de_aceite\nEND")) @map("tipo_contrato")

  empresa   Empresa @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "matriculas_empresa_fkey")
  aluno     Aluno   @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "matriculas_aluno_fkey")
  plano     Plano   @relation(fields: [companyId, planoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "matriculas_plano_fkey")
  criadoPor Usuario @relation("MatriculaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "matriculas_autor_fkey")
  /// INV-114 — a FK que da valor legal a tudo isto.
  /// **Opcional no TIPO, obrigatoria no BANCO.** O Prisma exige relacao
  /// opcional quando um dos escalares e opcional, e `tipoContrato` e gerada
  /// (nula na linha de termo). No banco a FK e NOT NULL nas tres colunas: a
  /// matricula sem aceite de contrato e recusada com `23503`.
  aceite    Aceite? @relation(fields: [usuarioId, tipoContrato, contratoVersao], references: [usuarioId, tipoContrato, versao], onDelete: Restrict, onUpdate: NoAction, map: "matriculas_contrato_aceito_fkey")

  @@index([companyId, alunoId], map: "matriculas_aluno_idx")
  @@index([companyId, fim], map: "matriculas_fim_idx")
  @@map("matriculas")
}

// ---------------------------------------------------------------------------
// SPEC-025 — avaliacao das aulas
// ---------------------------------------------------------------------------

/// A nota que o aluno da a UMA AULA (uma ocupacao de origem TURMA).
///
/// **A aula nao tem media propria; as notas dela alimentam a media da
/// TURMA.** O motivo e o objetivo do Israel: "identificar com facilidade os
/// detratores". Media por aula quase nunca teria volume — cada aula tem
/// poucos alunos — mas a NOTA por aula aponta para a terca-feira concreta em
/// que a pessoa se decepcionou, e e isso que um gestor consegue agir.
///
/// **Nao e anonima para o gestor** (ADR-017, item 4), e a tela do aluno diz
/// isso antes de ele escrever.
model AvaliacaoDeAula {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  ocupacaoId String   @map("ocupacao_id") @db.Uuid
  alunoId    String   @map("aluno_id") @db.Uuid
  /// 1..5, com CHECK no banco (INV-025c). O DTO protege a API; o CHECK
  /// protege a tabela de qualquer outro caminho.
  nota       Int      @db.SmallInt
  /// Texto puro, ate 500. Sem markdown nem HTML: isto aparece no painel do
  /// gestor, e HTML vindo do aluno seria XSS la dentro.
  comentario String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // DRIFT FECHADO EM 2026-09-01, e **quem se ajusta e o schema, nao o banco** —
  // mesma decisao de `presencas` (ver o comentario la, que a explica).
  //
  // A migration da SPEC-025 nomeou estas tres FKs `_aluno_fkey`,
  // `_company_fkey` e `_ocupacao_fkey`; sem `map:` o Prisma queria o padrao
  // dele (`_aluno_id_fkey`...) e `migrate diff` NUNCA fechava.
  //
  // O STATUS registrava isso como "drift pre-existente", sugerindo acidente
  // no banco de producao. **Era falso, e o banco de DEV provou:** criado do
  // zero das mesmas migrations, reproduziu os tres nomes identicos. A
  // divergencia estava aqui, na fonte.
  //
  // O que custava mais que o cosmetico: drift permanente esconde drift novo,
  // e `migrate diff` e o detector que as proximas dez specs vao usar.
  empresa  Empresa        @relation(fields: [companyId], references: [id], map: "avaliacoes_de_aula_company_fkey")
  /// DEF-024 fase 1 — as duas passam a carregar a empresa.
  ocupacao OcupacaoQuadra @relation(fields: [companyId, ocupacaoId], references: [companyId, id], onDelete: Cascade, map: "avaliacoes_de_aula_ocupacao_fkey")
  aluno    Aluno          @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Cascade, map: "avaliacoes_de_aula_aluno_fkey")

  @@unique([ocupacaoId, alunoId], map: "avaliacoes_de_aula_ocupacao_aluno_key")
  @@index([ocupacaoId])
  @@index([companyId])
  @@index([alunoId])
  @@map("avaliacoes_de_aula")
}

// ==========================================================================
// SPEC-032 — rastreabilidade de acao administrativa
//
// DUAS tabelas, e a cisao entre elas e o achado que reprovou a v1 da spec: a
// ACAO e o gesto humano (uma), os EVENTOS sao os alvos tecnicos (N). A v1
// dizia que o evento apontava por FK para UMA ocupacao E que criar 40
// ocorrencias gerava UM evento — as duas coisas nao cabem juntas.
// ==========================================================================

enum TipoDeAcao {
  reserva_criada
  reserva_cancelada
  /// SPEC-034: mover uma reserva avulsa (PATCH /bookings/:id).
  reserva_movida
  /// SPEC-034: cancelar UMA ocorrencia de turma. E o quarto caminho que
  /// poe ocupacao de TURMA em `cancelado`, e o unico que comeca por
  /// `turmas FOR UPDATE` de fora do ClassesService (D12).
  aula_cancelada
  pagamento_confirmado
  turma_criada
  turma_horario_editado
  credito_lancado
  credito_retirado
  /// SPEC-031/D21: o gestor tirou o aluno da turma. Precisa de nome proprio —
  /// `reserva_cancelada` nao descreve o gesto, e o alvo tecnico dele e uma
  /// MATRICULA, nao uma ocupacao (ver `EventoDeMatricula`).
  turma_aluno_removido
  /// SPEC-035/D7 — os tres gestos que o `status` da turma passou a fazer, e
  /// que ate 2026-09-09 nao faziam nada.
  ///
  /// **No FIM do enum, e nao junto das irmas `turma_*`**, pela mesma regra
  /// que o `movida` pagou: `ALTER TYPE ADD VALUE` sem `BEFORE`/`AFTER` anexa
  /// ao final, e declarar aqui em outra posicao criaria drift permanente.
  /// Terceira vez que esta regra governa este arquivo.
  ///
  /// Reusar `turma_horario_editado` foi recusado: a acao e o GESTO, e um
  /// extrato que dissesse "horario editado" para quem investigasse uma quadra
  /// que ficou livre mentiria.
  turma_inativada
  turma_reativada
  aula_reativada

  /// SPEC-068/D1 — trocar o professor de uma turma. Ate 2026-09-22 esse gesto
  /// nao deixava rastro NENHUM: o registrador vivia dentro do
  /// `if (precisaCancelar)`, e trocar so o professor nao entra la.
  ///
  /// **No FIM do enum**, pela quarta vez que esta regra governa este arquivo.
  turma_professor_alterado

  @@map("tipo_de_acao")
}

enum TipoDeEventoDeOcupacao {
  criada
  cancelada
  /// SPEC-034: a ocupacao nao mudou de status, mudou de lugar --
  /// `data`, `hora_inicio`, `hora_fim` e/ou `quadra_id`.
  movida
  reativada
  pagamento_confirmado

  @@map("tipo_de_evento_de_ocupacao")
}

/// O gesto humano. Uma por COMANDO LOGICO que escreve — **nao por
/// requisicao**: uma requisicao que cancela ocorrencias de tres turmas gera
/// TRES acoes, porque o agregado afetado e a turma. A matriz de identidade
/// esta na INV-078 da spec, e ela existe porque "comando logico" sem criterio
/// escrito era intuicao, nao regra.
///
/// **Append-only, imposto por trigger** (`acoes_append_only`) — nao por
/// ausencia de rota, que foi o que reprovou a v1. E nao por `REVOKE`: tabela
/// nova nao concede nada a PUBLIC e a aplicacao conecta como DONA do schema,
/// entao o REVOKE seria inocuo (medido).
model AcaoAdministrativa {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  tipo      TipoDeAcao
  /// A perna do AUTOR nao e composta, e e DE PROPOSITO (LIM-032f):
  /// `usuarios.company_id` e NULO para `super_admin`, e uma FK composta
  /// impediria o super admin de ser autor de qualquer coisa.
  autorId   String     @map("autor_id") @db.Uuid
  motivo    String?
  criadoEm  DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)

  empresa            Empresa             @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "acoes_empresa_fkey")
  autor              Usuario             @relation("AcaoRegistradaPor", fields: [autorId], references: [id], onDelete: Restrict, map: "acoes_autor_fkey")
  eventos            EventoDeOcupacao[]
  eventosDeMatricula EventoDeMatricula[]
  /// SPEC-069/D1 — a QUARTA tabela de efeito. Ate a SPEC-068 toda acao
  /// nascia de um efeito, e por isso "acao sem alvo" nao existia; o
  /// `garantirAcao()` tornou o estado alcancavel, e esta perna e o que o
  /// fecha para o gesto de professor.
  eventosDeTurma     EventoDeTurma[]

  movimentosDeCredito MovimentoDeCredito[]

  @@unique([companyId, id], map: "acoes_company_id_id_key")
  @@index([companyId, criadoEm(sort: Desc)], map: "acoes_company_criado_em_idx")
  @@map("acoes_administrativas")
}

/// O alvo tecnico. As duas FKs carregam a EMPRESA — a INV-054 ja ensinou que
/// "nao ha caminho hoje" nao e a mesma coisa que "o banco nao deixa", e foi
/// por confiar nisso que a SPEC-025 vazou nota de turma entre empresas.
model EventoDeOcupacao {
  id          String                 @id @default(uuid()) @db.Uuid
  companyId   String                 @map("company_id") @db.Uuid
  acaoId      String                 @map("acao_id") @db.Uuid
  ocupacaoId  String                 @map("ocupacao_id") @db.Uuid
  tipo        TipoDeEventoDeOcupacao
  /// Casa com `ocupacoes_quadra.transicao_id` (INV-064). NOT NULL aqui porque
  /// todo evento NASCE agora, diferente das ocupacoes ja existentes.
  transicaoId String                 @map("transicao_id") @db.Uuid
  criadoEm    DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)

  acao     AcaoAdministrativa @relation(fields: [companyId, acaoId], references: [companyId, id], onDelete: Restrict, map: "eventos_acao_fkey")
  ocupacao OcupacaoQuadra     @relation(fields: [companyId, ocupacaoId], references: [companyId, id], onDelete: Restrict, map: "eventos_ocupacao_fkey")

  @@index([companyId, ocupacaoId, criadoEm(sort: Desc)], map: "eventos_ocupacao_idx")
  @@index([companyId, acaoId], map: "eventos_acao_idx")
  @@map("eventos_de_ocupacao")
}

/// SPEC-031/D3 — a configuracao de operacao da empresa.
///
/// Sao DOIS prazos, uma coluna cada (REQ-001). A primeira versao da DDL tinha
/// um so, escrita pelo molde do irmao `config_pagamento_empresa` sem ler o
/// requisito que ela existe para satisfazer.
///
/// **NULO e a unica ausencia, e zero nao existe** (INV-065): o CHECK do banco
/// e `IS NULL OR >= 1` nos dois campos. Do lado do codigo, a ausencia vira o
/// tipo soma `PrazoDeCancelamento` — `number | null` deixaria `prazo ?? 0`
/// compilar, e um deles viraria "prazo zero" em silencio.
model ConfigOperacaoEmpresa {
  id                            String   @id @default(uuid()) @db.Uuid
  companyId                     String   @unique @map("company_id") @db.Uuid
  prazoCancelamentoAulaHoras    Int?     @map("prazo_cancelamento_aula_horas")
  prazoCancelamentoReservaHoras Int?     @map("prazo_cancelamento_reserva_horas")
  /// SPEC-046/D6 — nulo significa **usa o padrao**, nunca zero. Teto zero
  /// seria "nenhuma reposicao permitida", o oposto de "o clube nao configurou".
  reposicoesPorMes              Int?     @map("reposicoes_por_mes")
  reposicaoValidadeDias         Int?     @map("reposicao_validade_dias")
  /// SPEC-064/TASK-008 — card 5331, RN3: "Admin define a antecedência". Com
  /// quantas horas antes da aula a fila de AULA ainda chama alguém. Nulo =
  /// **usa o padrão de 2 h**, o comportamento de antes; zero não existe
  /// (`CHECK >= 1`). **Só a fila de aula**: a de turma não tem "a aula" (D4).
  antecedenciaFilaAulaHoras     Int?     @map("antecedencia_fila_aula_horas")
  /// SPEC-047/D1 — o preco de aula particular quando o professor nao tem o
  /// seu. Nulo aqui E no professor significa que o clube nao vende aula
  /// particular pelo app; o aluno nao ve ninguem, e a tentativa direta e
  /// recusada com `422 AULA_SEM_PRECO`.
  precoAulaPadrao               Decimal? @map("preco_aula_padrao") @db.Decimal(10, 2)
  /// SPEC-054/D1 — os nomes de exibição dos dois tipos fixos. Nulo = o padrão
  /// ("Quadra", "Aula particular"). Gravados SÓ por
  /// `PUT /company-settings/nomes-de-tipo`: o `gravar` da operação enumera os
  /// seus campos e nunca os toca, para um Admin antigo não os apagar.
  nomeTipoQuadra                String?  @map("nome_tipo_quadra")
  nomeTipoAula                  String?  @map("nome_tipo_aula")
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa Empresa @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "config_operacao_empresa_company_id_fkey")

  @@map("config_operacao_empresa")
}

/// SPEC-054/D1 — o catálogo LIVRE de tipos de adicional do clube ("Raquetes",
/// "Bolas"). O gestor dá nome; não inventa regra: cobrança, trava e devolução
/// são do comportamento Adicional, que é código.
model TipoDeAdicional {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  empresa    Empresa     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tipos_de_adicional_company_id_fkey")
  adicionais Adicional[]

  @@unique([companyId, id], map: "tipos_de_adicional_company_id_id_key")
  @@unique([companyId, nome], map: "tipos_de_adicional_nome_key")
  @@map("tipos_de_adicional")
}

/// SPEC-054 — o que o clube aluga junto com a reserva, com preço e estoque.
/// **Sem `DELETE` pela API:** tirar de oferta é `ativo: false`, porque o item de
/// reserva aponta para cá com `RESTRICT` e guarda o que foi cobrado.
model Adicional {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  tipoId    String   @map("tipo_id") @db.Uuid
  nome      String
  preco     Decimal  @db.Decimal(10, 2)
  /// D13 — baixar abaixo do já reservado é permitido; as reservas feitas não
  /// são tocadas. O banco confere o estoque só no momento em que a unidade é
  /// tomada (INV-133).
  estoque   Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tipo      TipoDeAdicional       @relation(fields: [companyId, tipoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "adicionais_tipo_fkey")
  ocupacoes AdicionalDaOcupacao[]

  @@unique([companyId, id], map: "adicionais_company_id_id_key")
  @@unique([companyId, nome], map: "adicionais_nome_key")
  @@map("adicionais")
}

/// SPEC-054/D5 — o item de uma reserva: **imutável, e só nasce na transação
/// que criou a ocupação** (INV-134). O `valorUnitario` congela o preço lido sob
/// a trava (D6); mudar o preço do adicional depois não muda a reserva feita.
model AdicionalDaOcupacao {
  id               String      @id @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  ocupacaoId       String      @map("ocupacao_id") @db.Uuid
  /// Coluna GERADA (`'AVULSO'`): o alvo da FK de origem — item em ocupação de
  /// turma é recusado com `23503` (INV-132). Nunca escrita pelo código.
  ///
  /// **O item é inserido por SQL cru, nunca por `adicionalDaOcupacao.create`.**
  /// A introspecção lê a expressão constante como `@default(AVULSO)`, e com esse
  /// default o Prisma ENVIA o valor — o Postgres recusa escrever em coluna gerada
  /// (`428C9`, medido em 2026-09-15). Trocar por `dbgenerated(...)` faz o
  /// `migrate diff` acusar diferença. Ler pela API de modelo funciona.
  origemDaOcupacao OrigemTipo? @default(AVULSO) @map("origem_da_ocupacao")
  adicionalId      String      @map("adicional_id") @db.Uuid
  quantidade       Int
  valorUnitario    Decimal     @map("valor_unitario") @db.Decimal(10, 2)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  adicional       Adicional       @relation(fields: [companyId, adicionalId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "adicionais_da_ocupacao_company_id_adicional_id_fkey")
  ocupacao        OcupacaoQuadra  @relation("AdicionalOcupacaoEmpresa", fields: [companyId, ocupacaoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "adicionais_da_ocupacao_company_id_ocupacao_id_fkey")
  ocupacaoPorTipo OcupacaoQuadra? @relation("AdicionalOcupacaoTipo", fields: [ocupacaoId, origemDaOcupacao], references: [id, origemTipo], onDelete: Restrict, onUpdate: NoAction, map: "adicionais_da_ocupacao_ocupacao_id_origem_da_ocupacao_fkey")

  @@unique([ocupacaoId, adicionalId], map: "adicionais_da_ocupacao_ocupacao_id_adicional_id_key")
  @@index([adicionalId], map: "adicionais_da_ocupacao_adicional_idx")
  @@map("adicionais_da_ocupacao")
}

/// SPEC-031/D13 — a falta que o aluno avisa sem sair da turma.
///
/// **Quatro FKs e tres pais.** A contagem esteve em tres versoes ao mesmo
/// tempo (cinco somando D13+D18, tres no D18, dois pais no D22/2b); a v13 da
/// spec a fechou. As quatro sao RESTRICT, e e isso que obriga a tabela a ser
/// apagada antes dos tres pais na sequencia de limpeza.
///
/// Nao ha FK simples para `alunos(id)`: a composta com `company_id` a
/// substitui. Declarar as duas manteria viva a forma que o D18 chama de "o
/// molde com o buraco" — `presencas` a tem, e so nao pode ser diferente
/// porque o `UNIQUE (company_id, id)` chegou depois, com a SPEC-032.
model FaltaAvisada {
  id         String     @id @default(uuid()) @db.Uuid
  companyId  String     @map("company_id") @db.Uuid
  ocupacaoId String     @map("ocupacao_id") @db.Uuid
  origemTipo OrigemTipo @default(TURMA) @map("origem_tipo")
  alunoId    String     @map("aluno_id") @db.Uuid
  avisadaEm  DateTime   @default(now()) @map("avisada_em") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa         Empresa        @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "faltas_company_id_fkey")
  ocupacaoPorTipo OcupacaoQuadra @relation("FaltaOcupacaoTipo", fields: [ocupacaoId, origemTipo], references: [id, origemTipo], onDelete: Restrict, map: "faltas_ocupacao_fkey")
  ocupacao        OcupacaoQuadra @relation("FaltaOcupacaoEmpresa", fields: [companyId, ocupacaoId], references: [companyId, id], onDelete: Restrict, map: "faltas_ocupacao_empresa_fkey")
  aluno           Aluno          @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, map: "faltas_aluno_empresa_fkey")

  /// AC-017: a idempotencia e do BANCO. `createMany({ skipDuplicates })` so
  /// funciona porque esta constraint existe — dois POST simultaneos produzem
  /// UMA linha.
  /// SPEC-046 — no maximo UMA (INV-118). O `?` do lado da reposicao e o que
  /// torna o credito derivado possivel: falta sem reposicao E o credito.
  reposicao ReposicaoDeAula?
  /// SPEC-064/INV-064e — as linhas da fila que gastam ESTE credito.
  filaDeEspera ListaDeEspera[]

  @@unique([ocupacaoId, alunoId], map: "faltas_unica")
  /// SPEC-064/TASK-001 (achado v4-04) — alvo da FK composta de
  /// `lista_de_espera`. `id` ja e PK, entao este UNIQUE nunca falha por
  /// duplicata: ele existe so para o `REFERENCES` de tres colunas ter onde
  /// se apoiar. **Com `aluno_id` DENTRO da chave**, porque sem ele a linha
  /// da fila podia apontar para o credito de OUTRO aluno da mesma empresa.
  @@unique([companyId, alunoId, id], map: "faltas_company_aluno_id_key")
  @@map("faltas_avisadas")
}

/// SPEC-046 — a reposicao de aula, que fecha o GAP-008.
///
/// **Sem coluna de saldo, de proposito (D1).** Credito e
/// `faltas_avisadas - reposicoes`, e a INV-118 (`UNIQUE (falta_id)`) e o que
/// torna essa subtracao segura sob concorrencia: sem ela, dois POST
/// simultaneos da mesma falta deixariam o credito NEGATIVO.
model ReposicaoDeAula {
  id         String     @id @default(uuid()) @db.Uuid
  companyId  String     @map("company_id") @db.Uuid
  alunoId    String     @map("aluno_id") @db.Uuid
  faltaId    String     @map("falta_id") @db.Uuid
  ocupacaoId String     @map("ocupacao_id") @db.Uuid
  /// Constante `TURMA` (INV-119), garantida por CHECK — o molde do
  /// `presencas.origem_tipo`. **Nao e coluna GERADA de proposito:** gerada
  /// obrigaria este campo a ser opcional, e com ele a relacao inteira, o que
  /// seria mentira no tipo. Repor em reserva avulsa o banco recusa.
  origemTipo OrigemTipo @default(TURMA) @map("origem_tipo")
  criadoEm   DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)

  empresa         Empresa        @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "reposicoes_company_fkey")
  aluno           Aluno          @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "reposicoes_aluno_fkey")
  ocupacaoPorTipo OcupacaoQuadra @relation("ReposicaoOcupacaoTipo", fields: [ocupacaoId, origemTipo], references: [id, origemTipo], onDelete: Restrict, onUpdate: NoAction, map: "reposicoes_ocupacao_tipo_fkey")
  ocupacao        OcupacaoQuadra @relation("ReposicaoOcupacaoEmpresa", fields: [companyId, ocupacaoId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "reposicoes_ocupacao_empresa_fkey")
  falta           FaltaAvisada   @relation(fields: [faltaId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "reposicoes_falta_fkey")

  /// INV-118 — `@@unique` com `map` explicito, e nao `@unique` no campo: o
  /// inline gera `reposicoes_de_aula_falta_id_key` e o `migrate diff` acusa
  /// drift contra o nome da migration. Terceira vez que este projeto paga
  /// nome de constraint divergente.
  @@unique([faltaId], map: "reposicoes_falta_unica")
  @@unique([ocupacaoId, alunoId], map: "reposicoes_aluno_ocupacao")
  @@index([companyId, alunoId], map: "reposicoes_aluno_idx")
  @@index([ocupacaoId], map: "reposicoes_ocupacao_idx")
  @@map("reposicoes_de_aula")
}

/// SPEC-031/D21 — o alvo tecnico da remocao administrativa.
///
/// `EventoDeOcupacao` nao serve: remover um aluno de uma turma **nao muda
/// ocupacao nenhuma**, entao nao haveria `ocupacaoId` honesto para preencher —
/// e inventar um produziria auditoria semanticamente falsa, que e pior que
/// auditoria ausente.
///
/// Segue a cisao da SPEC-032: a acao e o gesto humano (uma), os eventos sao os
/// alvos tecnicos (N). Aqui o alvo e uma MATRICULA.
///
/// **Append-only por trigger**, como as duas da SPEC-032 — e por isso entra
/// tambem no conjunto `APPEND_ONLY` de `limpar-empresa.ts`, que e diferente de
/// `TABELAS_DA_EMPRESA`: estar num nao poe no outro.
model EventoDeMatricula {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  acaoId    String   @map("acao_id") @db.Uuid
  turmaId   String   @map("turma_id") @db.Uuid
  alunoId   String   @map("aluno_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  acao  AcaoAdministrativa @relation(fields: [companyId, acaoId], references: [companyId, id], onDelete: Restrict, map: "eventos_matricula_acao_fkey")
  turma Turma              @relation(fields: [companyId, turmaId], references: [companyId, id], onDelete: Restrict, map: "eventos_matricula_turma_fkey")
  aluno Aluno              @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, map: "eventos_matricula_aluno_fkey")

  /// SPEC-069/TASK-001 — a tabela tinha SO a PK. O `acao_exige_alvo` do
  /// Deploy 2 confere `(company_id, acao_id)` a cada commit, e `company_id`
  /// LIDERA o btree: um `EXISTS` so por `acao_id` nao usaria indice nenhum.
  @@index([companyId, acaoId], map: "eventos_matricula_acao_idx")
  @@map("eventos_de_matricula")
}

/// SPEC-069/D1 — o alvo da acao de TURMA.
///
/// `turma_professor_alterado` era a unica acao sem evento nenhum: o extrato
/// dizia quem e quando, e nao dizia QUAL turma. A alternativa recusada era um
/// `turma_id` anulavel em `acoes_administrativas` — resolveria este alvo e
/// abriria precedente para `quadra_id`, `aluno_id`, `professor_id`.
///
/// As duas FKs carregam a EMPRESA, e as duas pernas importam: um evento com o
/// `company_id` da turma certa e a acao de OUTRA empresa e tao cross-tenant
/// quanto o inverso (INV-069d).
model EventoDeTurma {
  id        String              @id @default(uuid()) @db.Uuid
  companyId String              @map("company_id") @db.Uuid
  acaoId    String              @map("acao_id") @db.Uuid
  turmaId   String              @map("turma_id") @db.Uuid
  tipo      TipoDeEventoDeTurma
  criadoEm  DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)

  acao  AcaoAdministrativa @relation(fields: [companyId, acaoId], references: [companyId, id], onDelete: Restrict, map: "eventos_turma_acao_fkey")
  turma Turma              @relation(fields: [companyId, turmaId], references: [companyId, id], onDelete: Restrict, map: "eventos_turma_turma_fkey")

  /// O de LEITURA, espelhando o `eventos_ocupacao_idx` do irmao: FK nao cria
  /// indice no Postgres, e sem ele tanto o leitor da TASK-003 quanto a
  /// checagem RESTRICT de todo `DELETE` de turma pagam varredura.
  @@index([companyId, turmaId, criadoEm(sort: Desc)], map: "eventos_turma_idx")
  @@index([companyId, acaoId], map: "eventos_turma_acao_idx")
  @@map("eventos_de_turma")
}

/// SPEC-069 — um valor so, e de proposito. O evento nomeia o GESTO; os gestos
/// de grade continuam em `eventos_de_ocupacao` (LIM-069a).
enum TipoDeEventoDeTurma {
  professor_alterado

  @@map("tipo_de_evento_de_turma")
}

/// SPEC-033 — o ledger da carteira. **Escrito a mao, e a migration TAMBEM.**
///
/// As duas colunas geradas aparecem aqui como `@default(dbgenerated(...))`,
/// que e como o Prisma as REPRESENTA — nao e o que elas sao. Gerar DDL a
/// partir deste modelo produz `DEFAULT CASE ...`, que o Postgres recusa com
/// `0A000`. Por isso a migration desta spec e SQL manual, e este modelo serve
/// para o CLIENTE, nao para gerar o banco.
model MovimentoDeCredito {
  id                String               @id @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  alunoId           String               @map("aluno_id") @db.Uuid
  tipo              TipoMovimentoCredito
  valorCentavos     Int                  @map("valor_centavos")
  motivo            String?
  autorId           String               @map("autor_id") @db.Uuid
  acaoId            String               @map("acao_id") @db.Uuid
  ocupacaoId        String?              @map("ocupacao_id") @db.Uuid
  movimentoOrigemId String?              @map("movimento_origem_id") @db.Uuid
  criadoEm          DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)

  /// GERADA: constante 'consumo' na devolucao, nula nos outros tipos (D5).
  origemTipo     TipoMovimentoCredito? @default(dbgenerated("\nCASE\n    WHEN (tipo = 'devolucao'::tipo_movimento_credito) THEN 'consumo'::tipo_movimento_credito\n    ELSE NULL::tipo_movimento_credito\nEND")) @map("origem_tipo")
  /// GERADA: constante 'AVULSO' em consumo/devolucao, nula nos outros (INV-097).
  ocupacaoOrigem OrigemTipo?           @default(dbgenerated("\nCASE\n    WHEN (tipo = ANY (ARRAY['consumo'::tipo_movimento_credito, 'devolucao'::tipo_movimento_credito])) THEN 'AVULSO'::origem_tipo\n    ELSE NULL::origem_tipo\nEND")) @map("ocupacao_origem")

  acao     AcaoAdministrativa @relation(fields: [companyId, acaoId], references: [companyId, id], onUpdate: NoAction, map: "movimentos_acao_fkey")
  aluno    Aluno              @relation(fields: [companyId, alunoId], references: [companyId, id], onUpdate: NoAction, map: "movimentos_aluno_fkey")
  autor    Usuario            @relation("MovimentoRegistradoPor", fields: [autorId], references: [id], onUpdate: NoAction)
  ocupacao OcupacaoQuadra?    @relation(fields: [companyId, ocupacaoId, alunoId, ocupacaoOrigem], references: [companyId, id, alunoId, origemTipo], onUpdate: NoAction, map: "movimentos_ocupacao_avulsa_fkey")

  /// A FK simples do estorno, e a CAUSAL de seis colunas (D5) — as duas
  /// apontam para esta mesma tabela, por isso as relacoes sao nomeadas.
  origem          MovimentoDeCredito?  @relation("EstornoSimples", fields: [movimentoOrigemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  estornos        MovimentoDeCredito[] @relation("EstornoSimples")
  origemCausal    MovimentoDeCredito?  @relation("EstornoCausal", fields: [movimentoOrigemId, origemTipo, companyId, alunoId, ocupacaoId, valorCentavos], references: [id, tipo, companyId, alunoId, ocupacaoId, valorCentavos], onUpdate: NoAction, map: "movimentos_origem_causal_fkey")
  estornosCausais MovimentoDeCredito[] @relation("EstornoCausal")

  @@unique([id, tipo, companyId, alunoId, ocupacaoId, valorCentavos], map: "movimentos_origem_alvo_key")
  /// SPEC-069/TASK-001 — os indices desta tabela lideravam por `id`
  /// (o UNIQUE de seis colunas) ou eram parciais de `movimento_origem_id`.
  /// Nenhum servia ao `EXISTS` por `(company_id, acao_id)` do Deploy 2.
  @@index([companyId, acaoId], map: "movimentos_acao_idx")
  @@map("movimentos_de_credito")
}

enum TipoMovimentoCredito {
  entrada
  retirada
  consumo
  devolucao

  @@map("tipo_movimento_credito")
}

/// SPEC-040 — a semana em que o professor atende.
///
/// **Mesma forma de `HorarioFuncionamento`**, com um dono diferente: uma
/// linha por `(professor, dia)`, com as horas ou a flag de indisponivel. As
/// quatro garantias (dia valido, coerencia, hora cheia, unicidade) sao
/// `CHECK`/indice no banco, nao promessa de aplicacao.
///
/// **Ausencia de linha e "nao atende"** (D3). Nao ha heranca da empresa aqui,
/// ao contrario do horario da quadra: herdar faria todo professor ja
/// cadastrado nascer disponivel o dia inteiro, o que e falso e abriria agenda
/// na SPEC-039 para quem nao combinou nada.
model DisponibilidadeProfessor {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  professorId String   @map("professor_id") @db.Uuid
  /// 0 = domingo, como `Date.getDay()`.
  diaSemana   Int      @map("dia_semana") @db.SmallInt
  /// NOT NULL, e sem `indisponivel`: a D3 removeu a heranca, entao linha
  /// existe = atende. Ver o comentario da migration.
  horaInicio  DateTime @map("hora_inicio") @db.Time(0)
  horaFim     DateTime @map("hora_fim") @db.Time(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  empresa   Empresa   @relation(fields: [companyId], references: [id], map: "disponibilidades_empresa_fkey")
  /// FK COMPOSTA (DEF-024): sem `company_id` na chave, a agenda de um
  /// professor da empresa A poderia apontar para a ficha da B.
  professor Professor @relation(fields: [companyId, professorId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction, map: "disponibilidades_professor_fkey")

  @@unique([companyId, professorId, diaSemana], map: "disponibilidades_professor_dia_key")
  @@index([companyId, professorId], map: "disponibilidades_professor_idx")
  @@map("disponibilidades_professor")
}

// ===========================================================================
// SPEC-062 — infraestrutura de push (card 5328, parte 1)
// ===========================================================================

/// SPEC-062/D2 — a assinatura e do APARELHO, nao da pessoa.
///
/// **`endpoint` e UNIQUE global, e isso e a INV-062d.** Um aparelho tem um
/// dono por vez; registrar `endpoint` que ja pertence a outro usuario volta
/// `409 ENDPOINT_EM_USO` (achado v2-06 da SPEC-061: a autenticacao prova a
/// CONTA, nunca o controle do aparelho, e transferir por declaracao seria
/// sequestro de avisos).
///
/// **Os tres campos sao CREDENCIAL** (INV-062f): `endpoint`, `p256dh` e `auth`
/// dao a quem os tiver a capacidade de mandar push naquele aparelho. Nunca em
/// log, telemetria, resposta ou mensagem de erro — no log vai a impressao de 8
/// caracteres, nao o valor.
model AssinaturaPush {
  id        String @id @db.Uuid
  companyId String @map("company_id") @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid
  /// CREDENCIAL. Ver o bloco acima antes de logar isto em qualquer lugar.
  endpoint  String
  p256dh    String
  auth      String

  criadaEm       DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)
  ultimoUsoEm    DateTime? @map("ultimo_uso_em") @db.Timestamptz(6)
  falhasSeguidas Int       @default(0) @map("falhas_seguidas")

  /// INV-062c — FK COMPOSTA para `usuarios(company_id, id)`. FK simples nao
  /// saberia de `company_id`, e um aviso podia cruzar empresa. `CASCADE`
  /// porque assinatura de usuario que nao existe mais nao tem destino.
  usuario Usuario @relation(fields: [companyId, usuarioId], references: [companyId, id], onDelete: Cascade, map: "assinaturas_push_usuario_fkey")

  @@unique([endpoint], map: "assinaturas_push_endpoint_key")
  @@index([companyId, usuarioId], map: "assinaturas_push_usuario_idx")
  @@map("assinaturas_push")
}

/// SPEC-062/D4 — a caixa de saida.
///
/// **`origem_id` e OPACO aqui de proposito:** quem enfileira decide o que por
/// nele (a SPEC-063 usa a acao administrativa; a SPEC-064, a linha da fila). O
/// emissor nunca o abre — e foi por nao ter de abrir que `expira_em` precisou
/// existir: o TTL do Web Push sai DAQUI, nao de perguntar ao dominio.
model Notificacao {
  id             String  @id @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  destinatarioId String  @map("destinatario_id") @db.Uuid
  origemId       String? @map("origem_id") @db.Uuid
  tipo           String
  titulo         String
  corpo          String
  destinoUrl     String? @map("destino_url")

  criadaEm DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)
  /// D1a — o prazo do fato, informado por quem enfileira. `NULL` = sem prazo,
  /// e o TTL vira `TTL_PADRAO` (24 h). Com prazo, o TTL e
  /// `floor(expira_em - now())` e abaixo de 1 segundo NAO se envia: a linha
  /// vira `expirada` (transicoes 5 e 6).
  expiraEm DateTime? @map("expira_em") @db.Timestamptz(6)

  estado             EstadoDaNotificacao @default(pendente)
  /// D4b — a tentativa conta na REIVINDICACAO, nao no fim. Quem morre no meio
  /// do envio queima a tentativa: e a escolha conservadora, e a unica que
  /// impede laco infinito por processo que morre sempre no mesmo ponto.
  tentativas         Int                 @default(0)
  proximaTentativaEm DateTime            @default(now()) @map("proxima_tentativa_em") @db.Timestamptz(6)
  reivindicadaAte    DateTime?           @map("reivindicada_ate") @db.Timestamptz(6)
  /// INV-062e — a CERCA. So o dono da reivindicacao conclui; o emissor com
  /// lease vencido nao consegue escrever (transicoes 2, 3 e 6).
  reivindicadaPor    String?             @map("reivindicada_por")
  concluidaEm        DateTime?           @map("concluida_em") @db.Timestamptz(6)
  ultimoErro         String?             @map("ultimo_erro")

  /// SPEC-065/D2 — **"lido" e do SERVIDOR, nao do aparelho.** `NULL` e nao
  /// lida. Quem tem celular e computador ve a mesma caixa; marcar lido num e
  /// continuar com bolinha no outro e o que faz a pessoa parar de confiar no
  /// numero, e contador em que ninguem confia e pior que contador nenhum.
  ///
  /// **Nao tem nada a ver com `expira_em`** (D7): aquele responde ate quando
  /// vale a pena TENTAR enviar; este, se a pessoa ja leu.
  lidaEm DateTime? @map("lida_em") @db.Timestamptz(6)

  /// INV-062c — FK COMPOSTA, mesma razao da `assinaturas_push`. Sem `CASCADE`:
  /// apagar usuario e gesto de dominio que a SPEC-062 nao decide.
  destinatario Usuario @relation(fields: [companyId, destinatarioId], references: [companyId, id], map: "notificacoes_destinatario_fkey")

  /// A reivindicacao varre por aqui: `estado` + `proxima_tentativa_em`, na
  /// ordem de `criada_em`.
  @@index([estado, proximaTentativaEm, criadaEm], map: "notificacoes_fila_idx")
  /// D6 — o teto horario do aviso de teste conta por aqui (duas igualdades e
  /// um range). Persistente de proposito: o `@Throttle` vive na memoria do
  /// processo, e reiniciar zerava a janela.
  @@index([destinatarioId, tipo, criadaEm], map: "notificacoes_teste_janela_idx")
  /// SPEC-065/D8 — **a caixa de entrada, e ela e UM indice so.**
  ///
  /// Os outros dois nao servem: o da fila comeca por `estado`, e o do teste
  /// tem `tipo` no meio. Nenhum tinha `company_id`, ao contrario da convencao
  /// do resto do schema.
  ///
  /// A contagem de nao-lidas usa este mesmo: os dois primeiros campos vem do
  /// indice, e `lida_em IS NULL AND tipo <> 'teste'` e filtro sobre as linhas
  /// de UMA pessoa. Um indice parcial dedicado so se paga quando alguem
  /// acumular milhares de avisos -- e acrescenta-lo agora seria pagar escrita
  /// em toda a fila por uma leitura que ainda nao doi.
  @@index([companyId, destinatarioId, criadaEm(sort: Desc), id(sort: Desc)], map: "notificacoes_caixa_idx")
  @@map("notificacoes")
}

/// SPEC-062/D4 — os sete estados da caixa de saida.
///
/// **Nao-terminais: `pendente` e `enviando`.** Os outros cinco sao terminais, e
/// o CHECK `notificacoes_terminal_conclusao_chk` obriga `concluida_em` a
/// acompanhar — ver a migration. Ordem NOVA entra no FIM: `ALTER TYPE ADD
/// VALUE` sem `BEFORE`/`AFTER` anexa ao final, e declarar aqui em outra posicao
/// cria drift permanente (a mesma regra que governa `TipoDeAcao`).
enum EstadoDaNotificacao {
  pendente
  enviando
  aceita_pelo_servico
  sem_destino
  falha_definitiva
  falha_operacional
  /// O prazo venceu antes do envio. **Nao e falha:** o aviso nao falhou, ele
  /// venceu — e quem le o relatorio precisa da diferenca (achado T02 da 3a
  /// rodada de validacao, que derrubou a versao anterior da transicao 4).
  expirada

  @@map("estado_da_notificacao")
}

/// SPEC-064 (card 5331) — **a lista de espera.**
///
/// Duas filas na mesma tabela, com direitos diferentes (D1): por VAGA DE
/// MATRICULA numa turma (`turma_id`) ou por VAGA DE REPOSICAO numa aula
/// (`ocupacao_id`). Nunca as duas, nunca nenhuma — `fila_um_alvo_chk`.
///
/// **Quatro coisas aqui sao do BANCO e nao deste arquivo**, e a migration
/// `20260920200000_spec064_lista_de_espera` e a fonte de verdade das quatro:
///
///   1. os dois CHECK (`fila_um_alvo_chk`, `fila_credito_chk`);
///   2. os quatro indices UNICOS PARCIAIS — um chamado por alvo (INV-064a) e
///      uma inscricao ativa por aluno e alvo (INV-064b). O Prisma nao expressa
///      `WHERE`, e sem o `WHERE` uma passagem pela fila proibiria a segunda
///      para sempre;
///   3. o `ON DELETE SET NULL (falta_id)` da FK do credito — ver abaixo;
///   4. a ORDEM de encerrar a fila antes de apagar a falta (TASK-004), que
///      nenhuma constraint consegue impor.
model ListaDeEspera {
  id          String                @id @db.Uuid
  companyId   String                @map("company_id") @db.Uuid
  alunoId     String                @map("aluno_id") @db.Uuid
  /// Fila de TURMA. Exclusivo com `ocupacaoId` (`fila_um_alvo_chk`).
  turmaId     String?               @map("turma_id") @db.Uuid
  /// Fila de AULA. Exclusivo com `turmaId`.
  ocupacaoId  String?               @map("ocupacao_id") @db.Uuid
  /// O credito que da direito a fila de AULA. Vira `NULL` quando a falta e
  /// apagada, e e por isso que `fila_credito_chk` so exige credito nos dois
  /// estados ativos.
  faltaId     String?               @map("falta_id") @db.Uuid
  estado      EstadoDaFilaDeEspera  @default(aguardando)
  criadaEm    DateTime              @default(now()) @map("criada_em") @db.Timestamptz(6)
  chamadoEm   DateTime?             @map("chamado_em") @db.Timestamptz(6)
  /// D4 — nunca passa de 2h antes da aula (AC-004). Prazo impossivel encerra
  /// sem chamar, em vez de chamar para uma vez que ja nasceu vencida.
  chamadoAte  DateTime?             @map("chamado_ate") @db.Timestamptz(6)
  concluidaEm DateTime?             @map("concluida_em") @db.Timestamptz(6)
  motivoFim   String?               @map("motivo_fim")

  aluno    Aluno           @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, map: "fila_aluno_fkey")
  turma    Turma?          @relation(fields: [companyId, turmaId], references: [companyId, id], onDelete: Restrict, map: "fila_turma_fkey")
  ocupacao OcupacaoQuadra? @relation(fields: [companyId, ocupacaoId], references: [companyId, id], onDelete: Restrict, map: "fila_ocupacao_fkey")

  /// INV-064g — **o banco faz `ON DELETE SET NULL (falta_id)`, com a coluna
  /// NOMEADA, e o Prisma NAO SABE ESCREVER ISSO.**
  ///
  /// `onDelete: SetNull` no Prisma exige que TODOS os campos da relacao sejam
  /// opcionais — e `companyId`/`alunoId` sao `NOT NULL`. Pior: o `SET NULL` sem
  /// lista de colunas, que e o unico que o Prisma gera, anula as tres e o
  /// `DELETE` da falta morre com `23502`. Foi exatamente esse o primeiro
  /// bloqueio da validacao independente desta spec.
  ///
  /// Por isso aqui vai `NoAction` — que e o que o Prisma consegue dizer — e a
  /// acao real esta na migration. **Nao rode `prisma migrate dev` sobre este
  /// modelo esperando reproduzir o banco:** ele geraria `NO ACTION` e desfaria
  /// a metade da INV-064g que custou duas rodadas.
  falta FaltaAvisada? @relation(fields: [companyId, alunoId, faltaId], references: [companyId, alunoId, id], onDelete: NoAction, onUpdate: NoAction, map: "fila_falta_fkey")

  @@map("lista_de_espera")
}

/// SPEC-064/D2 — os seis estados da fila.
///
/// **Nao-terminais: `aguardando` e `chamado`.** Sao exatamente os dois que os
/// quatro indices parciais e o `fila_credito_chk` citam — quem acrescentar um
/// estado nao-terminal tem de mexer nos tres lugares, e o banco nao avisa.
///
/// Ordem NOVA entra no FIM (mesma regra de `EstadoDaNotificacao` e `TipoDeAcao`).
enum EstadoDaFilaDeEspera {
  /// Na fila.
  aguardando
  /// E a vez dele, ate `chamado_ate`.
  chamado
  /// Entrou na turma / marcou a reposicao.
  atendida
  /// O prazo venceu.
  expirada
  /// O alvo morreu, ou o aluno perdeu o direito (os sete caminhos da D6).
  encerrada
  /// Saiu por conta propria.
  desistiu

  @@map("estado_da_fila_de_espera")
}

/// SPEC-074 — **a pre-reserva: o aviso de que um horario de quadra vagou.**
///
/// O aluno toca num horario OCUPADO e pede para ser avisado; quando ele vagar,
/// **todos** que pediram recebem o aviso ao mesmo tempo, e quem reservar
/// primeiro fica com ele. Nada e segurado para ninguem (LIM-074a).
///
/// **Quatro coisas aqui sao do BANCO e nao deste arquivo**, e a migration
/// `20260925180000_spec074_pre_reserva` e a fonte de verdade das quatro:
///
///   1. os tres CHECK (faixa, conclusao, aviso);
///   2. os quatro indices PARCIAIS `WHERE estado = 'aguardando'` -- o Prisma
///      nao expressa `WHERE`, e sem ele um pedido avisado proibiria o proximo
///      para sempre;
///   3. o trigger `pre_reserva_slot_imutavel` (INV-074h), que recusa mudar o
///      slot ou o instante depois da criacao;
///   4. o indice e o CHECK do aviso em `notificacoes` (INV-074d).
model PreReserva {
  id           String             @id @db.Uuid
  companyId    String             @map("company_id") @db.Uuid
  alunoId      String             @map("aluno_id") @db.Uuid
  quadraId     String             @map("quadra_id") @db.Uuid
  /// O slot, na mesma forma de `ocupacoes_quadra` (D6).
  data         DateTime           @db.Date
  horaInicio   DateTime           @map("hora_inicio") @db.Time
  horaFim      DateTime           @map("hora_fim") @db.Time
  /// D6 — o instante do inicio, gravado na criacao por
  /// `instanteNoFusoDoClube`, para o SQL comparar com `now()` sem conhecer
  /// fuso. Redundante com `data` + `horaInicio`, e sem CHECK que os amarre:
  /// na criacao quem garante e a aplicacao; depois, o trigger.
  inicioEm     DateTime           @map("inicio_em") @db.Timestamptz(6)
  estado       EstadoDaPreReserva @default(aguardando)
  criadaEm     DateTime           @default(now()) @map("criada_em") @db.Timestamptz(6)
  /// D7 — a chave do rodizio e `coalesce(verificada_em, criada_em)`.
  verificadaEm DateTime?          @map("verificada_em") @db.Timestamptz(6)
  avisadaEm    DateTime?          @map("avisada_em") @db.Timestamptz(6)
  concluidaEm  DateTime?          @map("concluida_em") @db.Timestamptz(6)
  motivoFim    String?            @map("motivo_fim")

  aluno  Aluno  @relation(fields: [companyId, alunoId], references: [companyId, id], onDelete: Restrict, map: "pre_reserva_aluno_fkey")
  quadra Quadra @relation(fields: [companyId, quadraId], references: [companyId, id], onDelete: Restrict, map: "pre_reserva_quadra_fkey")

  @@map("pre_reservas")
}

/// SPEC-074 — os cinco estados da pre-reserva. **Nao-terminal: so
/// `aguardando`.** `avisada` e terminal por decisao do Israel (decisao 4): um
/// aviso por pedido.
///
/// Ordem NOVA entra no FIM (mesma regra de `EstadoDaNotificacao`).
enum EstadoDaPreReserva {
  /// Esperando o horario vagar.
  aguardando
  /// O horario vagou e o aviso saiu.
  avisada
  /// O proprio aluno desistiu.
  cancelada
  /// O horario comecou sem vagar.
  expirada
  /// Perdeu o sentido: o aluno deixou de ser operante, ou reservou sozinho.
  encerrada

  @@map("estado_da_pre_reserva")
}
